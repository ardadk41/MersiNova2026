<Window x:Class="MersiNova.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MersiNova — Çiftçi Giriş &amp; Kayıt"
        Height="730" Width="510"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Border Background="#081220" BorderBrush="#1C3D68" BorderThickness="1.5" CornerRadius="20"
            MouseDown="Window_MouseDown" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.75" BlurRadius="35" ShadowDepth="10"/>
        </Border.Effect>

        <Grid Margin="26,18,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar & Close -->
                <RowDefinition Height="Auto"/> <!-- Logo & Brand -->
                <RowDefinition Height="Auto"/> <!-- Mode Switcher: Giriş vs Yeni Kayıt -->
                <RowDefinition Height="*"/>    <!-- Form Fields Scrollable -->
            </Grid.RowDefinitions>

            <!-- 1. Custom Title Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛡️" FontSize="13" Margin="0,0,6,0"/>
                    <TextBlock Text="MersiNova Güvenli Giriş &amp; Üretici Kayıt Kapısı" Foreground="#7E93AA" FontSize="11.5" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Close Button -->
                <Button HorizontalAlignment="Right" Click="CloseButton_Click"
                        Width="28" Height="28" Background="#14253D" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="cbd" Background="{TemplateBinding Background}" CornerRadius="14">
                                <TextBlock Text="✕" Foreground="#B2C7DF" FontSize="12" FontWeight="Bold" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="cbd" Property="Background" Value="#E74C3C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 2. Logo & Brand -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                <Border Width="54" Height="54" CornerRadius="16" Margin="0,0,0,8" HorizontalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFD600" Offset="0"/>
                            <GradientStop Color="#FF6D00" Offset="0.6"/>
                            <GradientStop Color="#00E676" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#FFD600" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
                    </Border.Effect>
                    <TextBlock Text="🌱" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Mersi" FontSize="24" FontWeight="ExtraBold" Foreground="#ECEFF4"/>
                    <TextBlock Text="Nova" FontSize="24" FontWeight="ExtraBold" Foreground="#FFD600"/>
                    <Border Background="#0E2D20" BorderBrush="#1C5E43" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Akıllı Tarım AI" FontSize="10" FontWeight="Bold" Foreground="#00E676"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Akıllı Meyve &amp; Zirai Karar Destek ve Teşhis Sistemi" 
                           FontSize="11" Foreground="#7E93AA" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- 3. Mode Switcher: [🔑 Giriş Yap] vs [📝 Yeni Kayıt Ol] -->
            <Border Grid.Row="2" Background="#0C1B33" CornerRadius="12" Padding="3" Margin="0,0,0,12" BorderBrush="#1C3D68" BorderThickness="1.2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="TabLoginModeBtn" Grid.Column="0" Click="SwitchToLoginMode_Click"
                            Background="#102E4E" BorderBrush="#00E676" BorderThickness="1.2"
                            Height="34" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🔑" FontSize="12" Margin="0,0,5,0"/>
                            <TextBlock x:Name="LoginModeText" Text="Çiftçi Girişi" FontWeight="Bold" Foreground="#00E676" FontSize="11.5"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="TabRegisterModeBtn" Grid.Column="1" Click="SwitchToRegisterMode_Click"
                            Background="Transparent" BorderThickness="0"
                            Height="34" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📝" FontSize="12" Margin="0,0,5,0"/>
                            <TextBlock x:Name="RegisterModeText" Text="Yeni Kayıt Ol" FontWeight="SemiBold" Foreground="#8FA3BF" FontSize="11.5"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 4. Form Content (Scrollable if necessary) -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Common Error Message Banner -->
                    <Border x:Name="ErrorBanner" Background="#3D1414" BorderBrush="#E74C3C" BorderThickness="1.2"
                            CornerRadius="10" Padding="12,6" Margin="0,0,0,10" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⚠️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="ErrorText" Text="Hata mesajı" 
                                       Foreground="#FF8A80" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Common Map Verified Success Banner -->
                    <Border x:Name="MapSuccessBanner" Background="#0C2E1F" BorderBrush="#00E676" BorderThickness="1.2"
                            CornerRadius="10" Padding="10,6" Margin="0,0,0,10" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🗺️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="MapSuccessText" Text="Google Maps ile bahçe konumu doğrulandı!" 
                                       Foreground="#A7F3D0" FontSize="10.5" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- ==================== MODE 1: LOGIN FORM PANEL ==================== -->
                    <StackPanel x:Name="LoginFormPanel" Visibility="Visible">

                        <!-- 1. Username Input (ONLY LETTERS) -->
                        <Grid Margin="2,0,0,4">
                            <TextBlock Text="Kullanıcı Adı:" Foreground="#B2C7DF" FontSize="11.5" FontWeight="SemiBold"/>
                            <TextBlock Text="(Yalnızca Harf)" Foreground="#00E676" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Background="#0C1B33" BorderBrush="#1C3D68" BorderThickness="1.5" CornerRadius="12" 
                                Height="40" Padding="12,0" Margin="0,0,0,10">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="👤" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="UsernameBox"
                                         Text="arda"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#ECEFF4"
                                         FontSize="13"
                                         FontWeight="SemiBold"
                                         VerticalAlignment="Center"
                                         PreviewTextInput="UsernameBox_PreviewTextInput"
                                         PreviewKeyDown="UsernameBox_PreviewKeyDown"
                                         KeyDown="Input_KeyDown"/>
                            </Grid>
                        </Border>

                        <!-- 2. Password Input (EXACTLY 4 NUMBERS ONLY) -->
                        <Grid Margin="2,0,0,4">
                            <TextBlock Text="Şifre:" Foreground="#B2C7DF" FontSize="11.5" FontWeight="SemiBold"/>
                            <TextBlock Text="(Zorunlu: 4 Haneli Sayı)" Foreground="#FFD600" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Background="#0C1B33" BorderBrush="#1C3D68" BorderThickness="1.5" CornerRadius="12" 
                                Height="40" Padding="12,0" Margin="0,0,0,12">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔒" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <PasswordBox Grid.Column="1" x:Name="PasswordBox"
                                             Password="1234"
                                             MaxLength="4"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="#ECEFF4"
                                             FontSize="14"
                                             VerticalAlignment="Center"
                                             PreviewTextInput="PasswordBox_PreviewTextInput"
                                             PreviewKeyDown="PasswordBox_PreviewKeyDown"
                                             KeyDown="Input_KeyDown"/>
                                <TextBlock Grid.Column="2" x:Name="PasswordCounterText" Text="4/4" Foreground="#00E676" FontSize="10" FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <!-- 3. Location Header with Mandatory Badge -->
                        <Grid Margin="2,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📍 Bahçe Net Konum Bilgisi" Foreground="#FFD600" FontSize="11.5" FontWeight="Bold"/>
                                <Border Background="#4A1515" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="ZORUNLU" Foreground="#FF5252" FontSize="8.5" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="(Dolu &amp; Yağmur radarı için)" Foreground="#5A718C" FontSize="10" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Location Input Box with Map Icon Button & GPS Button Right Beside It -->
                        <Border Background="#0C1B33" BorderBrush="#1C3D68" BorderThickness="1.5" CornerRadius="12" 
                                Padding="10,6" Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📍" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="LocationBox"
                                             Text="Mersin / Erdemli - Limonlu Mahallesi"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="#ECEFF4"
                                             FontSize="11.5"
                                             FontWeight="SemiBold"
                                             TextWrapping="Wrap"
                                             VerticalAlignment="Center"
                                             KeyDown="Input_KeyDown"/>

                                    <Button Grid.Column="2" Click="OpenGoogleMaps_Click"
                                            Background="#14365A" BorderBrush="#00E676" BorderThickness="1.2"
                                            Padding="8,4" Cursor="Hand" ToolTip="Google Maps Haritasını Aç (Uydu Görüntüsü ile Bahçe Seç)">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                        BorderThickness="1.2" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🗺️" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Harita" Foreground="#00E676" FontSize="10" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,5,0,0">
                                    <TextBlock Text="🛰️ Google Maps uydu katmanı hazır" Foreground="#4A6585" FontSize="9.5" VerticalAlignment="Center"/>
                                    <Button HorizontalAlignment="Right" Click="AutoDetectLocation_Click"
                                            Background="#102544" BorderBrush="#1C3D68" BorderThickness="1"
                                            Padding="8,2" Cursor="Hand" ToolTip="Cihaz GPS Konumunu Çek">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                        BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <TextBlock Text="📡 GPS Al" Foreground="#38BDF8" FontSize="9.5" FontWeight="SemiBold"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Quick Location Preset Chips -->
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,12">
                            <TextBlock Text="Hızlı:" Foreground="#5A718C" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button Click="QuickLocation_Click" Tag="Mersin / Erdemli - Limonlu Havzası (36.6025° K, 34.3142° D)"
                                    Background="#102544" Foreground="#B2C7DF" FontSize="9.5" Padding="7,2" Margin="0,0,4,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="🍋 Erdemli"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Click="QuickLocation_Click" Tag="Mersin / Silifke - Göksu Vadisi (36.3778° K, 33.9344° D)"
                                    Background="#102544" Foreground="#B2C7DF" FontSize="9.5" Padding="7,2" Margin="0,0,4,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="🍊 Silifke"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Click="QuickLocation_Click" Tag="Mersin / Tarsus - Narenciye Ovası (36.9167° K, 34.8950° D)"
                                    Background="#102544" Foreground="#B2C7DF" FontSize="9.5" Padding="7,2" Margin="0,0,4,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="🍋 Tarsus"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Click="QuickLocation_Click" Tag="Adana / Yüreğir - Portakal Bahçesi (36.9850° K, 35.3289° D)"
                                    Background="#102544" Foreground="#B2C7DF" FontSize="9.5" Padding="7,2" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="🍊 Yüreğir"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- Submit Button -->
                        <Button x:Name="LoginButton" Click="LoginButton_Click" IsDefault="True" Height="44" Cursor="Hand" Margin="0,0,0,8">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="lbd" CornerRadius="12">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00E676" Offset="0"/>
                                                <GradientStop Color="#00B0FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="🌱" FontSize="15" Margin="0,0,8,0"/>
                                            <TextBlock Text="GİRİŞ YAP &amp; BAHÇEYE BAĞLAN" FontWeight="Bold" Foreground="#04121E" FontSize="12.5"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="lbd" Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Information Footnote -->
                        <Border Background="#0C1B33" CornerRadius="10" Padding="8,5" BorderBrush="#16325C" BorderThickness="1">
                            <TextBlock Foreground="#7E93AA" FontSize="10" TextAlignment="Center">
                                <Run Text="🔑 Giriş: "/>
                                <Run Text="arda / 1234" FontWeight="Bold" Foreground="#ECEFF4"/>
                                <Run Text=" veya yeni oluşturduğunuz çiftçi hesabınız"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <!-- ==================== MODE 2: REGISTER FORM PANEL ==================== -->
                    <StackPanel x:Name="RegisterFormPanel" Visibility="Collapsed">
                        <Border Background="#102544" BorderBrush="#00E676" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📝" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Yeni Çiftçi &amp; Narenciye Parseli Kaydı" Foreground="#00E676" FontWeight="Bold" FontSize="11.5"/>
                            </StackPanel>
                        </Border>

                        <!-- 1. Registration Username (ONLY LETTERS) -->
                        <Grid Margin="2,0,0,4">
                            <TextBlock Text="Adınız / Kullanıcı Adınız:" Foreground="#B2C7DF" FontSize="11.5" FontWeight="SemiBold"/>
                            <TextBlock Text="(Yalnızca Harf)" Foreground="#00E676" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Background="#0C1B33" BorderBrush="#1C3D68" BorderThickness="1.5" CornerRadius="12" 
                                Height="40" Padding="12,0" Margin="0,0,0,10">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="👤" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="RegUsernameBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#ECEFF4"
                                         FontSize="12.5"
                                         FontWeight="SemiBold"
                                         VerticalAlignment="Center"
                                         PreviewTextInput="UsernameBox_PreviewTextInput"
                                         PreviewKeyDown="UsernameBox_PreviewKeyDown"
                                         KeyDown="RegInput_KeyDown"/>
                            </Grid>
                        </Border>

                        <!-- 2. Registration Password (4 DIGITS) -->
                        <Grid Margin="2,0,0,4">
                            <TextBlock Text="4 Haneli Şifre:" Foreground="#B2C7DF" FontSize="11.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="RegPassCounterText" Text="0/4" Foreground="#FFD600" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Background="#0C1B33" BorderBrush="#1C3D68" BorderThickness="1.5" CornerRadius="12" 
                                Height="40" Padding="12,0" Margin="0,0,0,10">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔒" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <PasswordBox Grid.Column="1" x:Name="RegPasswordBox"
                                             MaxLength="4"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="#ECEFF4"
                                             FontSize="13"
                                             VerticalAlignment="Center"
                                             PreviewTextInput="PasswordBox_PreviewTextInput"
                                             PreviewKeyDown="PasswordBox_PreviewKeyDown"
                                             KeyDown="RegInput_KeyDown"/>
                            </Grid>
                        </Border>

                        <!-- 3. Registration Password Confirm (4 DIGITS) -->
                        <Grid Margin="2,0,0,4">
                            <TextBlock Text="Şifre Tekrar:" Foreground="#B2C7DF" FontSize="11.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="RegPassConfirmCounterText" Text="0/4" Foreground="#8FA3BF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Background="#0C1B33" BorderBrush="#1C3D68" BorderThickness="1.5" CornerRadius="12" 
                                Height="40" Padding="12,0" Margin="0,0,0,10">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔐" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <PasswordBox Grid.Column="1" x:Name="RegPasswordConfirmBox"
                                             MaxLength="4"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="#ECEFF4"
                                             FontSize="13"
                                             VerticalAlignment="Center"
                                             PreviewTextInput="PasswordBox_PreviewTextInput"
                                             PreviewKeyDown="PasswordBox_PreviewKeyDown"
                                             KeyDown="RegInput_KeyDown"/>
                            </Grid>
                        </Border>

                        <!-- 4. Registration Location -->
                        <Grid Margin="2,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📍 Bahçe Net Konum Bilgisi" Foreground="#FFD600" FontSize="11" FontWeight="Bold"/>
                                <Border Background="#4A1515" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="ZORUNLU" Foreground="#FF5252" FontSize="8" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="(Dolu &amp; Yağmur radarı için)" Foreground="#5A718C" FontSize="10" HorizontalAlignment="Right"/>
                        </Grid>

                        <Border Background="#0C1B33" BorderBrush="#1C3D68" BorderThickness="1.5" CornerRadius="12" 
                                Padding="10,6" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📍" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" x:Name="RegLocationBox"
                                             Text="Mersin / Erdemli - Limonlu Mahallesi"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="#ECEFF4"
                                             FontSize="11.5"
                                             FontWeight="SemiBold"
                                             TextWrapping="Wrap"
                                             VerticalAlignment="Center"
                                             KeyDown="RegInput_KeyDown"/>

                                    <Button Grid.Column="2" Click="RegOpenGoogleMaps_Click"
                                            Background="#14365A" BorderBrush="#00E676" BorderThickness="1.2"
                                            Padding="8,4" Cursor="Hand" ToolTip="Google Maps Haritasını Aç">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                        BorderThickness="1.2" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🗺️" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Harita" Foreground="#00E676" FontSize="10" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,4,0,0">
                                    <TextBlock Text="🛰️ Google Maps uydu katmanı hazır" Foreground="#4A6585" FontSize="9" VerticalAlignment="Center"/>
                                    <Button HorizontalAlignment="Right" Click="RegAutoDetectLocation_Click"
                                            Background="#102544" BorderBrush="#1C3D68" BorderThickness="1"
                                            Padding="7,2" Cursor="Hand" ToolTip="Cihaz GPS Konumunu Çek">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                        BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                    <TextBlock Text="📡 GPS Al" Foreground="#38BDF8" FontSize="9.5" FontWeight="SemiBold"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Register Submit Button -->
                        <Button x:Name="RegisterButton" Click="RegisterButton_Click" Height="44" Cursor="Hand" Margin="0,2,0,8">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="rbd" CornerRadius="12">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FFD600" Offset="0"/>
                                                <GradientStop Color="#00E676" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="🌱" FontSize="15" Margin="0,0,8,0"/>
                                            <TextBlock Text="HESABIMI OLUŞTUR VE GİRİŞ YAP" FontWeight="Bold" Foreground="#04121E" FontSize="12.5"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="rbd" Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Register Footnote -->
                        <Border Background="#0C1B33" CornerRadius="10" Padding="8,5" BorderBrush="#16325C" BorderThickness="1">
                            <TextBlock Foreground="#7E93AA" FontSize="10" TextAlignment="Center">
                                <Run Text="✅ Kaydınız yerel SQLite veritabanına işlenecek ve sistem açılacaktır."/>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</Window>
