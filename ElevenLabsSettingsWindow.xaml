<Window x:Class="MersiNova.ElevenLabsSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ElevenLabs.io Yapay Zeka Ses Ayarları — MersiNova"
        Height="470" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseDown="Window_MouseDown">

    <Border Background="#071322" BorderBrush="#8A2BE2" BorderThickness="1.5" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect Color="#8A2BE2" BlurRadius="25" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Form Body -->
                <RowDefinition Height="Auto"/> <!-- Footer Buttons -->
            </Grid.RowDefinitions>

            <!-- ==================== HEADER ==================== -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#1D1138" BorderBrush="#A855F7" BorderThickness="1" Margin="0,0,12,0">
                        <TextBlock Text="✨" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ElevenLabs.io Yapay Zeka Sesi" FontSize="16" FontWeight="ExtraBold" Foreground="#F3E8FF"/>
                        <TextBlock Text="MersiNova Ultra-Gerçekçi ve Akıcı Türkçe Ses Motoru" FontSize="11" Foreground="#A855F7" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="1" Click="CloseButton_Click"
                        Width="28" Height="28" Background="#1A1F36" BorderThickness="0" Cursor="Hand" ToolTip="Kapat">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                <TextBlock Text="✕" Foreground="#ECEFF4" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ==================== FORM BODY ==================== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                <StackPanel>
                    <!-- Explanatory Info Card -->
                    <Border Background="#101935" BorderBrush="#2D225A" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" LineHeight="17" Foreground="#D1D5DB">
                            <Bold Foreground="#C084FC">ElevenLabs (eleven_multilingual_v2):</Bold> İnsan doğallığında tonlama, nefes ve Türkçe telaffuz sunar. API anahtarınızı girerek MersiNova'yı stüdyo kalitesinde seslendirebilirsiniz. Anahtar girilmediğinde sistem kesintisiz yüksek kaliteli yerleşik ses motoruyla çalışmaya devam eder.
                        </TextBlock>
                    </Border>

                    <!-- API Key Input Field -->
                    <TextBlock Text="ElevenLabs API Anahtarı (xi-...):" FontSize="11.5" FontWeight="SemiBold" Foreground="#ECEFF4" Margin="0,0,0,6"/>
                    <Border Background="#0C1B30" BorderBrush="#2D3758" BorderThickness="1.2" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
                        <TextBox x:Name="ApiKeyBox" Background="Transparent" BorderThickness="0" Foreground="#00E676"
                                 FontSize="12" FontFamily="Consolas" VerticalAlignment="Center"
                                 Text="{Binding Path=ApiKey, UpdateSourceTrigger=PropertyChanged}"/>
                    </Border>

                    <!-- Voice Profile Selection -->
                    <TextBlock Text="MersiNova Ses Profili:" FontSize="11.5" FontWeight="SemiBold" Foreground="#ECEFF4" Margin="0,0,0,6"/>
                    <Border Background="#0C1B30" BorderBrush="#2D3758" BorderThickness="1.2" CornerRadius="8" Margin="0,0,0,14">
                        <ComboBox x:Name="VoiceComboBox" Background="#0C1B30" Foreground="#ECEFF4" BorderThickness="0"
                                  Padding="10,8" FontSize="12" Cursor="Hand"/>
                    </Border>

                    <!-- Status Notification & Test Feedback -->
                    <Border x:Name="StatusBadge" Background="#14233D" BorderBrush="#00E676" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,8">
                        <TextBlock x:Name="StatusBadgeText" Text="Durum: Kontrol ediliyor..." FontSize="11" Foreground="#00E676" FontWeight="Medium"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== FOOTER BUTTONS ==================== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Test Audio Button -->
                <Button Grid.Column="0" Click="TestSpeech_Click"
                        Background="#26123D" BorderBrush="#A855F7" BorderThickness="1.2"
                        Cursor="Hand" Padding="12,7">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🎧" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Test Et (MersiNova'yı Dinle)" Foreground="#C084FC" FontSize="11.5" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Save & Apply Button -->
                <Button Grid.Column="2" Click="SaveButton_Click" Margin="0,0,8,0"
                        Background="#00E676" BorderThickness="0" Cursor="Hand" Padding="16,7">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="💾" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Kaydet ve Uygula" Foreground="#04121E" FontSize="11.5" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Cancel Button -->
                <Button Grid.Column="3" Click="CloseButton_Click"
                        Background="#1A2536" BorderThickness="0" Cursor="Hand" Padding="14,7">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <TextBlock Text="Kapat" Foreground="#94A3B8" FontSize="11.5" FontWeight="SemiBold"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
