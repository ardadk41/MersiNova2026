                                        <TextBlock x:Name="ListenBtnText" Text="BENİ DİNLE (Konuşmaya Başla)" FontWeight="Bold" Foreground="#04121E" FontSize="13"/>
                                    </StackPanel>
                                </Button>

                                <!-- Finish Speaking / Quick Answer Button -->
                                <Button x:Name="FinishSpeakingBtn" Click="FinishSpeaking_Click"
                                        Width="280" Height="36" Background="#142C4E" BorderBrush="#00E676" BorderThickness="1"
                                        Cursor="Hand" Margin="0,0,0,14" Visibility="Collapsed">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
