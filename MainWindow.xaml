                                                    <Border Background="#13335A" CornerRadius="8" Width="30" Height="30" Margin="0,0,10,0">
                                                        <TextBlock Text="💧" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="SULAMA TAKVİMİ" Foreground="#7E93AA" FontSize="10" FontWeight="Bold"/>
                                                        <TextBlock x:Name="WaterDaysKpi" Text="2 Gün Sonra" Foreground="#3498DB" FontSize="16" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock x:Name="WaterText" 
                                                           Text="2 gün sonra sabah erken saatte damla sulama ile 40 dk su veriniz." 
                                                           Foreground="#B2C7DF" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- İlaç / Gübre -->
                                        <Border Grid.Column="2" Background="#102544" CornerRadius="14" Padding="16" BorderBrush="#1A3B66" BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Border Background="#3B2E15" CornerRadius="8" Width="30" Height="30" Margin="0,0,10,0">
                                                        <TextBlock Text="🧪" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="İLAÇ &amp; GÜBRELEME" Foreground="#7E93AA" FontSize="10" FontWeight="Bold"/>
                                                        <TextBlock x:Name="PesticideDaysKpi" Text="4 Gün Sonra" Foreground="#F39C12" FontSize="16" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock x:Name="PesticideText" 
                                                           Text="4 gün sonra potasyumlu yaprak gübresi uygulayınız. 6 gün sonra mildiyö koruyucu ilaçlama uygundur." 
                                                           Foreground="#B2C7DF" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- KPI 4: HASAT ÖNGÖRÜSÜ -->
                                    <Border Background="#102544" CornerRadius="14" Padding="16" BorderBrush="#1A3B66" BorderThickness="1" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#3A1C24" CornerRadius="10" Width="38" Height="38" Margin="0,0,14,0">
                                                <TextBlock Text="🌾" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="HASAT ZAMANI ÖNGÖRÜSÜ" Foreground="#7E93AA" FontSize="10" FontWeight="Bold"/>
                                                <TextBlock x:Name="HarvestText" Text="Yaklaşık 3 gün sonra hasat için en uygun lezzet ve sertliğe ulaşacaktır." 
                                                           Foreground="#E67E22" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- KPI 5: NARENCİYE HASTALIK TEŞHİSİ & TEDAVİ REÇETESİ -->
