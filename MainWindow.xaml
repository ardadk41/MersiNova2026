            <!-- ==================== VIEW 4: SQL DATABASE MANAGEMENT ==================== -->
            <Grid x:Name="SqlDatabaseView" Visibility="Collapsed" Background="#081220">
                <Grid Margin="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- SQL Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="📊 MersiNova Tarla &amp; Rekolte SQL Veritabanı" FontSize="20" FontWeight="Bold" Foreground="#ECEFF4"/>
                            <TextBlock x:Name="SqlDbPathText" Text="SQLite Veritabanı: mersinova_tarla.db" FontSize="12" Foreground="#3498DB" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Click="BackToAnaliz_Click"
                                Background="#102544" BorderBrush="#1E3E6B" BorderThickness="1.5"
                                Foreground="#ECEFF4" FontWeight="Bold" FontSize="13" Padding="18,8" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="← Analiz Ekranına Dön"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Query Bar -->
                    <Border Grid.Row="1" Background="#0C1B33" CornerRadius="12" Padding="14" Margin="0,0,0,16" BorderBrush="#183359" BorderThickness="1.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SQL Sorgusu:" Foreground="#00E676" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" x:Name="SqlQueryBox"
                                     Text="SELECT Id, TarlaAdi, UrunTuru, OlgunlukDurumu, OlgunlukYuzdesi, SulamaGunu, IlacGubreGunu, Tarih FROM TarlaAnalizleri ORDER BY Id DESC;"
                                     Background="#07101C" Foreground="#ECEFF4" FontFamily="Consolas" FontSize="12"
                                     BorderBrush="#1E3E6B" BorderThickness="1" Padding="10,6" Margin="0,0,12,0"/>
                            <Button Grid.Column="2" Click="ExecuteSql_Click"
                                    Background="#00E676" Foreground="#04121E" FontWeight="Bold" FontSize="12"
                                    Padding="16,8" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="▶ Çalıştır"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Real DataGrid -->
                    <Border Grid.Row="2" Background="#0C1B33" CornerRadius="12" BorderBrush="#183359" BorderThickness="1.5" Padding="2">
                        <DataGrid x:Name="SqlRecordsDataGrid"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  Background="#0A182C"
                                  Foreground="#ECEFF4"
                                  RowBackground="#0E1E36"
                                  AlternatingRowBackground="#122542"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#1A3B66"
                                  BorderThickness="0"
                                  FontSize="12"
                                  HeadersVisibility="Column"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================== VIEW 5: CANLI METEOROLOJİ & 7 GÜNLÜK ZİRAİ HAVA DURUMU ==================== -->
            <Grid x:Name="WeatherView" Visibility="Collapsed" Margin="24,14,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header & Action Bar -->
                    <RowDefinition Height="Auto"/> <!-- Current Live Hero Card -->
                    <RowDefinition Height="*"/>    <!-- 7-Day Forecast Cards & Agricultural Guidance -->
                </Grid.RowDefinitions>

                <!-- 1. Header & Actions -->
                <Border Grid.Row="0" Background="#0C1B33" BorderBrush="#1C3D68" BorderThickness="1.5" CornerRadius="16" Padding="20,12" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🌤️" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Meteoroloji Genel Müdürlüğü &amp; Radar Zirai Hava Durumu" 
                                           Foreground="#ECEFF4" FontSize="16" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                                <Border Background="#103622" CornerRadius="6" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="● Canlı Radar &amp; Uydu Verisi" Foreground="#00E676" FontSize="10.5" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="📍 Seçili Parsel:" Foreground="#7E93AA" FontSize="11.5" Margin="0,0,6,0"/>
                                <TextBlock x:Name="WeatherViewLocationText" Text="Mersin / Erdemli - Limonlu" Foreground="#FFD600" FontSize="11.5" FontWeight="Bold" Margin="0,0,12,0"/>
                                <TextBlock x:Name="WeatherViewCoordsText" Text="🌐 36.6025° K, 34.3142° D" Foreground="#88A0B8" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Click="RefreshWeather_Click"
                                    Background="#142C4E" BorderBrush="#00E676" BorderThickness="1.2"
                                    Padding="14,8" Margin="0,0,8,0" Cursor="Hand" ToolTip="Meteoroloji Verilerini Yenile">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔄" FontSize="12" Margin="0,0,6,0"/>
                                                <TextBlock Text="Verileri Güncelle" Foreground="#00E676" FontSize="11.5" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Click="SpeakWeatherReport_Click"
                                    Background="#221020" BorderBrush="#FF5252" BorderThickness="1.2"
                                    Padding="14,8" Cursor="Hand" ToolTip="Sesli Asistan Nova 7 Günlük Zirai Raporu Okusun">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🗣️" FontSize="12" Margin="0,0,6,0"/>
                                                <TextBlock Text="Hava Durumunu Seslendir" Foreground="#FF8A80" FontSize="11.5" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Current Live Weather Hero Card -->
                <Border Grid.Row="1" Background="#0A182C" BorderBrush="#18365D" BorderThickness="1.5" CornerRadius="18" Padding="24,18" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/> <!-- Big Temp & Weather Icon -->
                            <ColumnDefinition Width="*"/>   <!-- Live Metric Badges (Humidity, Wind, Rain, Risk) -->
                        </Grid.ColumnDefinitions>

                        <!-- Left: Live Weather Icon & Temp -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="HeroWeatherIcon" Text="☀️" FontSize="48" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="HeroTempText" Text="22.4" FontSize="38" FontWeight="ExtraBold" Foreground="#ECEFF4"/>
                                        <TextBlock Text="°C" FontSize="24" FontWeight="Bold" Foreground="#00E676" VerticalAlignment="Top" Margin="2,4,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="HeroWeatherDesc" Text="Açık &amp; Güneşli" Foreground="#FFD600" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="🌾 Narenciye İçin Elverişli İklim Şartları" Foreground="#7E93AA" FontSize="11" Margin="2,6,0,0"/>
                        </StackPanel>

                        <!-- Right: 4 Metrics Grid -->
                        <UniformGrid Grid.Column="1" Columns="4" VerticalAlignment="Center">
                            <!-- Humidity -->
                            <Border Background="#0E233E" CornerRadius="12" Padding="14,12" Margin="4,0" BorderBrush="#16385A" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="💧 Bağıl Nem" Foreground="#88A0B8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="HeroHumidityText" Text="%58" Foreground="#38BDF8" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock Text="Normal Seviye" Foreground="#5A718C" FontSize="9.5" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Wind -->
                            <Border Background="#0E233E" CornerRadius="12" Padding="14,12" Margin="4,0" BorderBrush="#16385A" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="💨 Rüzgar Hızı" Foreground="#88A0B8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="HeroWindText" Text="12 km/s" Foreground="#00E676" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock Text="Meltem / Sakin" Foreground="#5A718C" FontSize="9.5" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Rain -->
                            <Border Background="#0E233E" CornerRadius="12" Padding="14,12" Margin="4,0" BorderBrush="#16385A" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="🌧️ Anlık Yağış" Foreground="#88A0B8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="HeroRainText" Text="0.0 mm" Foreground="#FFD600" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock Text="Yağışsız" Foreground="#5A718C" FontSize="9.5" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Radar Risk -->
                            <Border Background="#0E233E" CornerRadius="12" Padding="14,12" Margin="4,0" BorderBrush="#16385A" BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="⚡ Afet Radarı" Foreground="#88A0B8" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="HeroRiskText" Text="Emniyetli" Foreground="#00E676" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock Text="Radar Aktif" Foreground="#5A718C" FontSize="9.5" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- 3. 7-Day Forecast & Agricultural Advice Cards -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Section Title -->
                        <RowDefinition Height="*"/>    <!-- 7 Day Cards Container -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Early Warning Guidance -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📅 7 GÜNLÜK GÜN GÜN ZİRAİ TAHMİN &amp; TARIMSAL REHBER" 
                               Foreground="#FFD600" FontSize="13" FontWeight="Bold" Margin="4,0,0,10"/>

                    <!-- 7 Daily Cards Scrollable / UniformGrid -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="DailyCardsPanel" Orientation="Horizontal"/>
                    </ScrollViewer>

                    <!-- Bottom Meteorological Alert Box -->
                    <Border Grid.Row="2" x:Name="WeatherAdviceBorder" Background="#0A2222" BorderBrush="#00E676" BorderThickness="1.5" CornerRadius="14" Padding="16,10" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="WeatherAdviceIcon" Text="🛡️" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="WeatherAdviceTitle" Text="METEOROLOJİK DEĞERLENDİRME: HAVA ŞARTLARI EMNİYETLİ" Foreground="#00E676" FontSize="11" FontWeight="ExtraBold"/>
                                <TextBlock x:Name="WeatherAdviceDetailText" 
                                           Text="Bölgenizde dolu veya aşırı sağanak yağış riski bulunmamaktadır. Hava şartları narenciye için tamamen elverişli ve emniyetli seyretmektedir." 
                                           Foreground="#ECEFF4" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            </Grid>
            <!-- END VIEWS CONTAINER -->

            <!-- FLOATING TOAST NOTIFICATION POPUP (OVERLAY) -->
            <Border Grid.Row="1" x:Name="ToastPopup" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,18,24,0" Background="#160810" BorderBrush="#FF5252" BorderThickness="1.5"
                    CornerRadius="16" Width="430" Padding="18,16" Visibility="Collapsed" Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastTranslate" Y="-160"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#FF1744" BlurRadius="28" ShadowDepth="6" Opacity="0.55"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Toast Header -->
                        <RowDefinition Height="Auto"/> <!-- Toast Body / Warning Cards -->
                        <RowDefinition Height="Auto"/> <!-- 10-Second Auto-dismiss Countdown -->
                    </Grid.RowDefinitions>

                    <!-- Toast Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#4A1218" CornerRadius="6" Padding="6,4" Margin="0,0,8,0">
                                <TextBlock Text="🚨" FontSize="14"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="ÖRNEK UYARILANDIRMA BİLDİRİMİ" Foreground="#FF5252" FontSize="11.5" FontWeight="ExtraBold"/>
                                <TextBlock Text="Zirai Radar &amp; Bahçe Koruma Asistanı" Foreground="#8899A6" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- MersiNova'yı Dinle Butonu -->
                            <Button Click="SpeakSampleToast_Click" Margin="0,0,6,0"
                                    Background="#260C14" BorderBrush="#FF5252" BorderThickness="1" 
                                    Padding="7,3" Cursor="Hand" ToolTip="MersiNova'yı Dinle">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔊" FontSize="10" Margin="0,0,3,0"/>
                                                <TextBlock Text="MersiNova'yı Dinle" Foreground="#FF8A80" FontSize="10" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Kapat Butonu -->
                            <Button Click="CloseToast_Click" 
                                    Width="24" Height="24" Background="#260C14" BorderThickness="0" Cursor="Hand" ToolTip="Kapat">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                            <TextBlock Text="✕" Foreground="#FF8A80" FontSize="11" FontWeight="Bold" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Toast Body -->
                    <StackPanel Grid.Row="1">
                        <!-- 1. Anlık Hava Değişimi Kartı -->
                        <Border Background="#2A0E16" CornerRadius="8" Padding="11,8" Margin="0,0,0,8" BorderBrush="#501620" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🌪️" FontSize="18" Margin="0,2,10,0" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="ANLIK HAVA DEĞİŞİMİ TESPİTİ" Foreground="#FF8A80" FontSize="11.5" FontWeight="Bold"/>
                                    <TextBlock Text="Önümüzdeki 90 dakika içinde şiddetli rüzgar (55 km/s) ve ani fırtına / sağanak geçişi beklenmektedir." 
                                               Foreground="#ECEFF4" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 2. Bahçeye Zarar Veren Konular & Alınacak Tedbirler Kartı -->
                        <Border Background="#241B08" CornerRadius="8" Padding="11,8" Margin="0,0,0,10" BorderBrush="#573D0B" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🍋" FontSize="18" Margin="0,2,10,0" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="BAHÇEYE ZARAR VEREN RİSKLER &amp; TEDBİR" Foreground="#FFD54F" FontSize="11.5" FontWeight="Bold"/>
                                    <TextBlock Text="Şiddetli rüzgar ve dolu meyve dökümüne ve kabuk yaralanmasına yol açabilir. Dolu tüllerini açınız, rüzgar kıranları kontrol ediniz; yağış sonrası hemen koruyucu bakır uygulaması yapınız." 
                                               Foreground="#ECEFF4" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Konum & Otomatik Kapanma Bilgisi -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock x:Name="ToastLocationText" Text="📍 Parsel: Mersin / Erdemli" 
                                       Foreground="#81D4FA" FontSize="10.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ToastCountdownText" Text="⏱️ 10 saniye sonra kapanacak" 
                                       Foreground="#FF8A80" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <!-- Progress bar for 10-second countdown -->
                    <Border Grid.Row="2" Background="#260C14" CornerRadius="3" Height="4" ClipToBounds="True">
                        <ProgressBar x:Name="ToastCountdownBar" Height="4" Minimum="0" Maximum="10" Value="10"
                                     Foreground="#FF5252" Background="Transparent" BorderThickness="0"/>
                    </Border>
                </Grid>
            </Border>

        </Grid>
        <!-- END MAIN CONTENT AREA -->
    </Grid>
    <!-- END ROOT GRID -->
</Window>
