                                <Button Click="QuickVoice_Click" Content="🌳 Ağaç gövdesinde zamk akıntısı var, ne yapmalıyım?" Style="{StaticResource QuickChipStyle}" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                                <Button Click="QuickVoice_Click" Content="🌾 300 limon ağacımdan kaç ton rekolte çıkar?" Style="{StaticResource QuickChipStyle}" Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
