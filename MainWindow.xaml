                                    <Rectangle x:Name="Wave1" Width="4" Height="16" Fill="#00E676" RadiusX="2" RadiusY="2" Margin="3,0"/>
                                    <Rectangle x:Name="Wave2" Width="4" Height="28" Fill="#00E676" RadiusX="2" RadiusY="2" Margin="3,0"/>
                                    <Rectangle x:Name="Wave3" Width="4" Height="38" Fill="#00E676" RadiusX="2" RadiusY="2" Margin="3,0"/>
                                    <Rectangle x:Name="Wave4" Width="4" Height="24" Fill="#00E676" RadiusX="2" RadiusY="2" Margin="3,0"/>
                                    <Rectangle x:Name="Wave5" Width="4" Height="14" Fill="#00E676" RadiusX="2" RadiusY="2" Margin="3,0"/>
                                </StackPanel>

                                <!-- Interactive Two-Way Listening Button: "Beni Dinle" -->
                                <Button x:Name="ToggleListenButton" Click="ToggleListen_Click" Width="280" Height="48" Cursor="Hand" Margin="0,0,0,8">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="lbd" CornerRadius="14">
                                                <Border.Background>
