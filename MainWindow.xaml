                        <!-- Interactive Dialogue & AI Orb -->
                        <RowDefinition Height="Auto"/>
                        <!-- Live Dialogue Input -->
                    </Grid.RowDefinitions>

                    <!-- Top Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="🎙️ MersiNova ile Karşılıklı Canlı Konuşma Alanı" FontSize="20" FontWeight="Bold" Foreground="#ECEFF4"/>
                            <TextBlock Text="Yapay zeka asistanınız MersiNova ile dilediğiniz gibi soru-cevap yapabilir, akıcı ve doğal ses tonuyla sohbet edebilirsiniz." 
                                       FontSize="12" Foreground="#7E93AA" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" Click="BackToAnaliz_Click"
                                Background="#102544" BorderBrush="#1E3E6B" BorderThickness="1.5"
                                Foreground="#ECEFF4" FontWeight="Bold" FontSize="12" Padding="16,8" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="← Saha Analizine Dön"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Center: Interactive AI Voice Orb & Dialogue Stream -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380"/>
                            <!-- Orb & Quick Voice Starters -->
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <!-- Dialogue Transcript Stream -->
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: Pulsating AI Orb & Voice Starter Buttons -->
                        <Border Grid.Column="0" Background="#0C1B33" CornerRadius="18" BorderBrush="#183359" BorderThickness="1.5" Padding="20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Glowing Voice Orb -->
                                <Border x:Name="VoiceOrbBorder" Width="130" Height="130" CornerRadius="65" Margin="0,0,0,16" HorizontalAlignment="Center">
                                    <Border.Background>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#00E676" Offset="0"/>
                                            <GradientStop Color="#00897B" Offset="0.7"/>
                                            <GradientStop Color="#0C1B33" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#00E676" BlurRadius="25" ShadowDepth="0" Opacity="0.8"/>
                                    </Border.Effect>
                                    <TextBlock x:Name="VoiceOrbIcon" Text="🎙️" FontSize="44" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock x:Name="LiveVoiceStatusText" Text="MersiNova Dinlemeye Hazır" 
                                           FontSize="14" FontWeight="Bold" Foreground="#00E676" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="LiveVoiceSubText" Text="MersiNova Akıcı Türkçe Yapay Zeka Sohbeti (ElevenLabs Doğal Tonlama)" FontSize="11" Foreground="#7E93AA" HorizontalAlignment="Center" Margin="0,2,0,12"/>

                                <!-- Animated Sound Waves -->
