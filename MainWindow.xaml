                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="💧" FontSize="16" Margin="0,0,8,0"/>
                                                <TextBlock Text="Haftalık Sulama İhtiyacı" Foreground="#7E93AA" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBlock x:Name="WeeklyWaterText" Text="~10.500 Litre / Hafta" Foreground="#3498DB" FontSize="17" FontWeight="Bold"/>
                                            <TextBlock Text="Ağaç başı ortalama 35 L damla sulama" Foreground="#5A718C" FontSize="10" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 4: Hasat İşgücü & Gün -->
                                    <Border Grid.Row="1" Grid.Column="2" Background="#0C1B33" CornerRadius="12" Padding="16" BorderBrush="#183359" BorderThickness="1">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="👨‍🌾" FontSize="16" Margin="0,0,8,0"/>
                                                <TextBlock Text="Tahmini Hasat Süresi" Foreground="#7E93AA" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBlock x:Name="LaborDaysText" Text="4 İşçi ile ~4 Gün" Foreground="#F39C12" FontSize="17" FontWeight="Bold"/>
