                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Spoken Advice Banner -->
                                <Border Background="#102544" CornerRadius="12" Padding="16" BorderBrush="#1A3B66" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="🤖 Nova'nın Rekolte Yorumu:" Foreground="#00E676" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
