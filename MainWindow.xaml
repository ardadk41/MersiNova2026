                                                <TextBlock x:Name="NetTonajKpiText" Text="5.65 Ton" Foreground="#00E676" FontSize="28" FontWeight="ExtraBold"/>
                                                <TextBlock x:Name="GrossTonajSubText" Text="(Brüt: 6.08 Ton)" Foreground="#7E93AA" FontSize="14" VerticalAlignment="Bottom" Margin="10,0,0,4"/>
                                            </StackPanel>
                                            <TextBlock Text="%7 standart fire/ıskarta payı düşülmüştür." Foreground="#5A718C" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="#16382B" CornerRadius="12" Padding="16,8" VerticalAlignment="Center">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="TAHMİNİ CİRO" Foreground="#7E93AA" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="EstimatedRevenueKpiText" Text="₺158.200 TL" Foreground="#00E676" FontSize="20" FontWeight="ExtraBold" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Grid of Detailed Cards -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Card 1: Toplam Meyve Adedi -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="#0C1B33" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="#183359" BorderThickness="1">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="🍏" FontSize="16" Margin="0,0,8,0"/>
                                                <TextBlock Text="Toplam Meyve Adedi" Foreground="#7E93AA" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TotalFruitCountText" Text="45.000 Adet" Foreground="#ECEFF4" FontSize="18" FontWeight="Bold"/>
                                            <TextBlock Text="Ağaç sayısı × Ağaç başı meyve" Foreground="#5A718C" FontSize="10" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 2: Kasa İhtiyacı -->
                                    <Border Grid.Row="0" Grid.Column="2" Background="#0C1B33" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="#183359" BorderThickness="1">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="🧺" FontSize="16" Margin="0,0,8,0"/>
                                                <TextBlock Text="Gereken Kasa Sayısı" Foreground="#7E93AA" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBlock x:Name="CrateCountText" Text="~283 Standart Kasa" Foreground="#3498DB" FontSize="18" FontWeight="Bold"/>
                                            <TextBlock Text="20 kg standart sebze/meyve kasası" Foreground="#5A718C" FontSize="10" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

