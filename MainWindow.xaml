<Window x:Class="MersiNova.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MersiNova — Akıllı Meyve &amp; Tarım Yapay Zekası &amp; Sesli Asistan"
        Height="880" Width="1440"
        MinHeight="720" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="#081220"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="DotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Fill" Value="#00E676"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>

        <!-- Modern Horizontal Chip Style -->
        <Style x:Key="QuickChipStyle" TargetType="Button">
            <Setter Property="Background" Value="#102544"/>
            <Setter Property="Foreground" Value="#B2C7DF"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="#1C3D68" BorderThickness="1.2"
                                CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#173E6D"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#00E676"/>
                                <Setter Property="Foreground" Value="#00E676"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderInputStyle" TargetType="Slider">
            <Setter Property="Margin" Value="0,6,0,10"/>
            <Setter Property="Foreground" Value="#00E676"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
        </Style>

        <!-- Modern High-Contrast Citrus ComboBox Style (Names 100% visible) -->
        <ControlTemplate x:Key="ModernCitrusComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="ToggleButton" ClickMode="Press" Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Border" Background="#0C203A" BorderBrush="#00E676" BorderThickness="1.5" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="1" Background="#102544" CornerRadius="0,8,8,0">
                                        <TextBlock Text="▼" Foreground="#00E676" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#FFD600"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <TextBlock x:Name="SelectedItemText" IsHitTestVisible="False"
                           Text="{Binding Path=SelectedItem, RelativeSource={RelativeSource TemplatedParent}}"
                           Foreground="#ECEFF4" FontWeight="Bold" FontSize="12.5"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           Margin="14,0,38,0"/>
                <Popup x:Name="Popup" Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True" Focusable="False"
                       PopupAnimation="Slide">
                    <Grid x:Name="DropDown" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
                        <Border x:Name="DropDownBorder" Background="#0A182C" BorderBrush="#1C3D68" BorderThickness="1.5" CornerRadius="10" Margin="0,4,0,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="4" Opacity="0.5"/>
                            </Border.Effect>
                            <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style x:Key="ModernCitrusComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Template" Value="{StaticResource ModernCitrusComboBoxTemplate}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#0A182C"/>
                        <Setter Property="Foreground" Value="#ECEFF4"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="Padding" Value="12,9"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#16325C"/>
                                <Setter Property="Foreground" Value="#00E676"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1B3A6B"/>
                                <Setter Property="Foreground" Value="#FFD600"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Content Area -->
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Border Grid.Row="0" Background="#0C1B33" BorderBrush="#183256" BorderThickness="0,0,0,1" Height="62">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.45" ShadowDepth="3" BlurRadius="12"/>
            </Border.Effect>
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="260"/>
                    <ColumnDefinition Width="*" MinWidth="340"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo & Brand (Clean & Compact) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFD600" Offset="0"/>
                                <GradientStop Color="#00E676" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="🌱" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Mersi" FontSize="20" FontWeight="ExtraBold" Foreground="#ECEFF4"/>
                            <TextBlock Text="Nova" FontSize="20" FontWeight="ExtraBold" Foreground="#FFD600"/>
                            <Border Background="#0E2D20" BorderBrush="#1C5E43" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="7,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Akıllı Tarım AI" FontSize="9.5" FontWeight="Bold" Foreground="#00E676"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Akıllı Meyve Teşhis, Ziraat &amp; Saha Danışmanı" FontSize="10.5" Foreground="#7E93AA"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Tabs (Saha Analizi | Sesli Sohbet | Rekolte | SQL | Hava Durumu) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="TabAnalizBtn" Click="TabAnaliz_Click"
                            Background="#16325C" Foreground="#00E676" FontWeight="Bold" FontSize="12"
                            Cursor="Hand" Padding="12,6" Margin="2,0" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="🌿  Saha Analizi" Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="TabVoiceChatBtn" Click="TabVoiceChat_Click"
                            Background="Transparent" Foreground="#8899AA" FontWeight="SemiBold" FontSize="12"
                            Cursor="Hand" Padding="12,6" Margin="2,0" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="🎙️  Sesli Asistan" Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="TabRekolteBtn" Click="TabRekolte_Click"
                            Background="Transparent" Foreground="#8899AA" FontWeight="SemiBold" FontSize="12"
                            Cursor="Hand" Padding="12,6" Margin="2,0" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="🌾  Rekolte" Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="TabSqlBtn" Click="TabSql_Click"
                            Background="Transparent" Foreground="#8899AA" FontWeight="SemiBold" FontSize="12"
                            Cursor="Hand" Padding="12,6" Margin="2,0" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="📊  Veritabanı" Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="TabWeatherBtn" Click="TabWeather_Click"
                            Background="Transparent" Foreground="#8899AA" FontWeight="SemiBold" FontSize="12"
                            Cursor="Hand" Padding="12,6" Margin="2,0" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="🌤️  Hava Durumu" Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Header Right Badges & Controls (Neat, Balanced & Non-overlapping) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- User & Location Badge -->
                    <Border Background="#102544" BorderBrush="#1C3D68" BorderThickness="1.2" CornerRadius="14" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👤" FontSize="11" Margin="0,0,4,0"/>
                            <TextBlock x:Name="HeaderUsernameText" Text="arda" Foreground="#00E676" FontWeight="Bold" FontSize="11" Margin="0,0,6,0"/>
                            <TextBlock Text="📍" FontSize="11" Margin="0,0,3,0"/>
                            <TextBlock x:Name="HeaderLocationText" Text="Mersin / Erdemli" Foreground="#FFD600" FontWeight="SemiBold" FontSize="11"
                                       MaxWidth="130" TextTrimming="CharacterEllipsis" ToolTip="Doğrulanan Parsel Konumu"/>
                        </StackPanel>
                    </Border>

                    <!-- Weather Early Warning Alert Bell Button -->
                    <Button x:Name="AlertBellButton" Click="ToggleAlertBanner_Click"
                            Background="#0E2442" BorderBrush="#1C4578" BorderThickness="1.2"
                            Padding="10,5" Margin="0,0,8,0" Cursor="Hand" ToolTip="Uyarılandırma Sistemini Göster / Gizle">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bbd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔔" FontSize="11" Margin="0,0,5,0"/>
                                        <TextBlock Text="Uyarı Sistemi" Foreground="#64B5F6" FontSize="11" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bbd" Property="Background" Value="#173B6B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- MersiNova Voice Toggle Button -->
                    <Button x:Name="VoiceToggleButton" Click="VoiceToggle_Click"
                            Background="#102544" BorderBrush="#1E3E6B" BorderThickness="1.2"
                            Cursor="Hand" Padding="10,5" Margin="0,0,8,0" ToolTip="MersiNova Sesli Asistanını Aç/Kapat">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="vbd" Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.2"
                                        CornerRadius="14" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="vbd" Property="Background" Value="#17345E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="VoiceIcon" Text="🔊" FontSize="12" Margin="0,0,5,0"/>
                            <TextBlock x:Name="VoiceStatusText" Text="MersiNova: Açık" FontSize="11" FontWeight="SemiBold" Foreground="#00E676"/>
                        </StackPanel>
                    </Button>

                    <!-- System Status Badge -->
                    <Border Background="#102544" CornerRadius="14" Padding="9,5" ToolTip="SQLite Veritabanı ve YOLO v8 Yapay Zeka Hazır">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#00E676" Margin="0,0,5,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#00E676" BlurRadius="5" ShadowDepth="0"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="AI &amp; SQL Aktif" Foreground="#ECEFF4" FontSize="10.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Warning System & Weather Bar -->
                <RowDefinition Height="*"/>    <!-- Main Views Area -->
            </Grid.RowDefinitions>

            <!-- ==================== TOP WARNING SYSTEM & SAMPLE TEST BAR ==================== -->
            <StackPanel Grid.Row="0">
                <!-- UYARILANDIRMA SİSTEMİ BİLGİLENDİRME & ÖRNEK BUTONU -->
                <Border x:Name="WarningSystemBar" Background="#0B1A30" BorderBrush="#1C3F70" BorderThickness="0,0,0,1"
                        Padding="18,9" Visibility="Visible">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sol: Uyarılandırma Sistemi Rozeti -->
                        <Border Grid.Column="0" Background="#11294D" BorderBrush="#20518E" BorderThickness="1.2" CornerRadius="8" 
                                Padding="11,5" Margin="0,0,14,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🛡️" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="UYARILANDIRMA SİSTEMİ" Foreground="#64B5F6" FontSize="11.5" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Orta: Anlık hava değişimi ve bahçeye zarar veren konularda uyarı vereceğini anlatan metin -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">
                                <Run Text="Anlık meteorolojik hava değişimleri" Foreground="#00E676" FontWeight="Bold" FontSize="11.5"/>
                                <Run Text=" (şiddetli rüzgar, fırtına, ani dolu, don olayları) ve " Foreground="#ECEFF4" FontSize="11.5"/>
                                <Run Text="bahçenize zarar veren kritik konularda" Foreground="#FFD54F" FontWeight="Bold" FontSize="11.5"/>
                                <Run Text=" sistem sizi önceden uyararak koruyucu zirai tedbir almanızı sağlar." Foreground="#ECEFF4" FontSize="11.5"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Sağ: 'Örnek' Boşluğu / Butonu -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SampleAlertButton" Click="ShowSampleWarningToast_Click"
                                    Background="#102E4E" BorderBrush="#00E676" BorderThickness="1.5"
                                    Cursor="Hand" Padding="14,6" ToolTip="Örnek uyarı bildirimini test et (10 saniye ekranda kalır)">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="sampleBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🔔" FontSize="12" Margin="0,0,6,0"/>
                                                <TextBlock Text="Örnek Uyarı Göster" Foreground="#00E676" FontSize="11.5" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="sampleBd" Property="Background" Value="#00E676"/>
                                                <Setter Property="Foreground" Value="#0A182F"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Canlı Meteoroloji Banner'ı (Gerektiğinde Açılabilir, Başlangıçta Kapalı) -->
                <Border x:Name="AlertBannerBar" Background="#140810" BorderBrush="#E74C3C" BorderThickness="0,0,0,1"
                        Padding="18,7" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Alert Pulse Icon -->
                        <Border Background="#4A1218" CornerRadius="8" Width="30" Height="30" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Center Alerts: Two clear badges side by side with clean descriptions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Dolu Uyarısı Badge -->
                            <Border x:Name="AlertHailBadgeBorder" Background="#0C253C" BorderBrush="#00E676" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="AlertHailTitleText" Text="🛡️ DOLU DURUMU" Foreground="#00E676" FontSize="10.5" FontWeight="Bold" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="AlertHailText" Text="Dolu riski bulunmuyor; hava emniyetli." Foreground="#ECEFF4" FontSize="11" FontWeight="Medium" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Yağmur Uyarısı Badge -->
                            <Border x:Name="AlertRainBadgeBorder" Background="#0C253C" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="AlertRainTitleText" Text="☀️ YAĞIŞ RAPORU" Foreground="#80D8FF" FontSize="10.5" FontWeight="Bold" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="AlertRainText" Text="Aşırı sağanak beklenmiyor; narenciye için elverişli." Foreground="#B3E5FC" FontSize="11" FontWeight="Medium" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Real-time Location Weather Ticker -->
                            <Border Background="#102544" BorderBrush="#1C3D68" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock x:Name="LiveWeatherTickerText" Text="📍 Anlık: 23°C • Nem: %61 • Rüzgar: 13 km/s" Foreground="#00E676" FontSize="10.5" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <!-- Right Actions: Voice Speak Alert & Dismiss Button -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Click="SpeakWeatherAlert_Click"
                                    Background="#2A101C" BorderBrush="#FF5252" BorderThickness="1"
                                    Padding="9,4" Margin="0,0,8,0" Cursor="Hand" ToolTip="Uyarının Detaylarını MersiNova'dan Dinle">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🔊" FontSize="11" Margin="0,0,5,0"/>
                                                <TextBlock Text="MersiNova'yı Dinle" Foreground="#FF8A80" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Click="DismissAlert_Click"
                                    Width="26" Height="26" Background="#260C14" BorderThickness="0" Cursor="Hand" ToolTip="Uyarı Çubuğunu Gizle">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="13">
                                            <TextBlock Text="✕" Foreground="#FF8A80" FontSize="11" FontWeight="Bold" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ==================== VIEWS CONTAINER (Row 1) ==================== -->
            <Grid Grid.Row="1">

            <!-- ==================== VIEW 1: SAHA ANALİZİ & CHAT ==================== -->
            <Grid x:Name="AnalysisView" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 🌤️ 1 HAFTALIK ZİRAİ HAVA DURUMU & GÖRSEL (SAHA ANALİZİ) -->
                    <RowDefinition Height="*"/>    <!-- Alt Panel: Çift Sütun (Sohbet & Fotoğraf Analizi) -->
                </Grid.RowDefinitions>

                <!-- ROW 0: 1 HAFTALIK ZİRAİ HAVA DURUMU & BAHÇE GÖRSELİ BANNERI -->
                <Border Grid.Row="0" Background="#0A1628" BorderBrush="#162D4A" BorderThickness="0,0,0,1.5" Padding="18,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top Title & Controls Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#16325C" CornerRadius="8" Padding="7,3" Margin="0,0,10,0">
                                    <TextBlock Text="🌤️ MGM &amp; METEOROLOJİK RADAR" Foreground="#00E676" FontSize="10.5" FontWeight="ExtraBold"/>
                                </Border>
                                <TextBlock Text="Saha Zirai Hava Durumu &amp; 7 Günlük Tarımsal Takvim" Foreground="#ECEFF4" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Location & Model in Center -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="📍 Seçili Parsel:" Foreground="#7E93AA" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock x:Name="SahaWeatherLocationText" Text="Mersin / Erdemli - Limonlu" Foreground="#FFD600" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="• Model: MGM / ECMWF Zirai İndeks" Foreground="#5A718C" FontSize="10.5" Margin="8,0,0,0"/>
                            </StackPanel>

                            <!-- Switch to Detailed Weather Tab Button & Collapse Toggle -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Click="TabWeather_Click" Background="#102544" BorderBrush="#1C3D68" BorderThickness="1"
                                        Padding="10,4" Cursor="Hand" Margin="0,0,6,0">
