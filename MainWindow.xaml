                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" Foreground="#ECEFF4" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Background="#16382B" CornerRadius="6" Padding="6,2" Margin="10,0">
                                                            <TextBlock Text="{Binding Date}" Foreground="#00E676" FontSize="10" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
