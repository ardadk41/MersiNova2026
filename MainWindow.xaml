                                                    <TextBlock Text="✅ " FontSize="12"/>
                                                    <TextBlock Text="Sözüm Bitti, Nova Yanıtlasın" Foreground="#00E676" FontSize="11.5" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <TextBlock Text="Hızlı Konuşma Başlatıcıları (Narenciye):" Foreground="#8FA3BF" FontSize="11" FontWeight="Bold" Margin="0,0,0,8" HorizontalAlignment="Left"/>
