                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="💾" FontSize="14" Margin="0,0,8,0"/>
                                                        <TextBlock Text="Bu Rekolteyi SQL'e Kaydet" FontWeight="Bold" Foreground="#04121E" FontSize="12"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- RIGHT: CALCULATED KPI DASHBOARD -->
                            <StackPanel Grid.Column="2">

                                <!-- Top Headline Banner -->
                                <Border Background="#102544" CornerRadius="14" Padding="20" Margin="0,0,0,16" BorderBrush="#1A3B66" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="TAHMİNİ NET REKOLTE" Foreground="#7E93AA" FontSize="11" FontWeight="Bold"/>
