                                    <!-- Fruits Per Tree Slider -->
                                    <Grid>
                                        <TextBlock Text="Ağaç Başına Ortalama Meyve Adedi:" Foreground="#8FA3BF" FontSize="11" FontWeight="SemiBold"/>
