                                                           Foreground="#B2C7DF" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                </StackPanel>
                            </Border>

                            <!-- RECENT ANALYSES LIST -->
                            <Border Background="#0C1B33" CornerRadius="16" BorderBrush="#183359" BorderThickness="1.5" Margin="0,20,0,0" Padding="18">
