                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="ToggleSahaWeatherBtn" Click="ToggleSahaWeather_Click"
                                        Content="▲" Foreground="#8899AA" FontSize="10" FontWeight="Bold"
                                        Width="26" Height="26" Background="#102544" BorderThickness="0" Cursor="Hand" ToolTip="Hava Durumu Kartlarını Gizle/Göster">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="13">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Main Weather Content: [ Left Visual Orchard Card ] + [ Right 7-Day Forecast Cards ] -->
                        <Grid Grid.Row="1" x:Name="SahaWeatherContentGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ===== LEFT: GÖRSEL (GOOGLE EARTH CANLI UYDU GÖRÜNTÜSÜ VE KESİN PARSEL BİLGİLERİ) ===== -->
                            <Border Grid.Column="0" Height="170" CornerRadius="12" Margin="0,0,12,0" ClipToBounds="True" BorderBrush="#00E676" BorderThickness="1.2"
                                    Cursor="Hand" ToolTip="Google Earth Web Üzerinde Canlı Görüntüle" MouseLeftButtonDown="OpenGoogleEarthWeb_Click">
                                <Grid>
                                    <!-- Google Earth Satellite Photography of Citrus Parcels -->
                                    <Image x:Name="SahaWeatherBannerImage" Stretch="UniformToFill" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    
                                    <!-- Glassmorphic Gradient Overlay for Readability -->
                                    <Border>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#25000000" Offset="0"/>
                                                <GradientStop Color="#60081424" Offset="0.45"/>
                                                <GradientStop Color="#D0050E1A" Offset="0.75"/>
                                                <GradientStop Color="#F0030912" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- Content inside Visual Card -->
                                    <Grid Margin="12,8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <!-- Top Badges -->
                                            <RowDefinition Height="*"/>    <!-- Center Temp & Icon -->
                                            <RowDefinition Height="Auto"/> <!-- Exact Definitive Info -->
                                        </Grid.RowDefinitions>

                                        <!-- Top Badges: Google Earth & Exact Coordinates -->
                                        <Grid Grid.Row="0">
                                            <Border HorizontalAlignment="Left" Background="#D908182B" BorderBrush="#00E676" BorderThickness="1" CornerRadius="6" Padding="6,2">
                                                <TextBlock Text="🛰️ Google Earth Web Uydu Görüntüsü" Foreground="#00E676" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <Border HorizontalAlignment="Right" Background="#D90B1E38" CornerRadius="6" Padding="6,2">
                                                <TextBlock Text="36.6025° K, 34.3142° D" Foreground="#81D4FA" FontSize="9.5" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>

                                        <!-- Center Temperature & Icon & Location -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,2">
                                            <TextBlock x:Name="SahaHeroWeatherIcon" Text="🌤️" FontSize="28" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                    <TextBlock x:Name="SahaHeroTempText" Text="23.5°C" FontSize="22" FontWeight="ExtraBold" Foreground="White" Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="SahaHeroDescText" Text="Açık &amp; Güneşli" FontSize="11" FontWeight="SemiBold" Foreground="#80D8FF" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="SahaBannerLocationText" Text="📍 Mersin / Erdemli - Limonlu Parseli" Foreground="#FFD600" FontSize="10.5" FontWeight="Bold"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Bottom Accurate & Definitive Information -->
                                        <StackPanel Grid.Row="2">
                                            <TextBlock x:Name="SahaHeroParamsText" Text="💧 Nem: %61  •  💨 Rüzgar: 13 km/s  •  🌧️ Yağış: 0.0 mm" Foreground="#ECEFF4" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                            <TextBlock Text="🌱 Kırmızı Akdeniz Toprağı (Terra Rossa) • Rakım: 25 m • Dolu &amp; Yağış Yok (Emniyetli)" Foreground="#69F0AE" FontSize="9" FontWeight="Medium"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- ===== RIGHT: 1 HAFTALIK GÜN GÜN TAHMİN KARTLARI ===== -->
                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="DailyCardsPanelSaha" Orientation="Horizontal" VerticalAlignment="Center"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ROW 1: ÇİFT SÜTUN (SOL SOHBET - SAĞ FOTOĞRAF VE YOLO) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="480"/>
                        <!-- Left: Interactive AI Chatbot -->
                        <ColumnDefinition Width="*"/>
                        <!-- Right: Photo Capture & YOLO Analysis -->
                    </Grid.ColumnDefinitions>

                <!-- ===== LEFT PANEL: AI CONVERSATION ===== -->
                <Border Grid.Column="0" Background="#091424" BorderBrush="#152B49" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Header -->
                            <RowDefinition Height="*"/>
                            <!-- Messages List -->
                            <RowDefinition Height="Auto"/>
                            <!-- Rich Scrollable Quick Chips Bar -->
                            <RowDefinition Height="Auto"/>
                            <!-- Input Box -->
                        </Grid.RowDefinitions>

                        <!-- Chat Header -->
                        <Border Grid.Row="0" Background="#0E1E36" Padding="18,12" BorderBrush="#152B49" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="#142C4E" CornerRadius="20" Width="38" Height="38" Margin="0,0,12,0">
                                    <TextBlock Text="🌱" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="MersiNova — Akıllı Yapay Zeka Tarım &amp; Meyve Asistanı" FontSize="13.5" FontWeight="Bold" Foreground="#ECEFF4"/>
                                    <TextBlock Text="Meyve Hastalıkları Teşhisi, Zirai Reçete ve Sesli Danışmanlık" FontSize="11" Foreground="#7E93AA"/>
                                </StackPanel>

                                <!-- Direct Voice Q&A Mode Button -->
                                <Button Grid.Column="2" Click="TabVoiceChat_Click"
                                        Background="#16382B" BorderBrush="#00E676" BorderThickness="1"
                                        Padding="10,5" Cursor="Hand" Margin="0,0,4,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🎙️" FontSize="12" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Karşılıklı Konuş" Foreground="#00E676" FontSize="11" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Messages ScrollViewer -->
                        <ScrollViewer Grid.Row="1" x:Name="ChatScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="16,10">
                            <StackPanel x:Name="ChatPanel" Margin="0,4"/>
                        </ScrollViewer>

                        <!-- Typing Indicator -->
                        <Border x:Name="TypingIndicator" Grid.Row="1" VerticalAlignment="Bottom" 
                                HorizontalAlignment="Left" Margin="20,0,0,10"
                                Background="#0E1E36" CornerRadius="16,16,16,4" Padding="14,9"
                                Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.3" ShadowDepth="2" BlurRadius="6"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TypingIndicatorText" Text="🔍 Google &amp; Web Veritabanı taranıyor..." Foreground="#00E676" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="Dot1" Style="{StaticResource DotStyle}"/>
                                    <Ellipse x:Name="Dot2" Style="{StaticResource DotStyle}"/>
                                    <Ellipse x:Name="Dot3" Style="{StaticResource DotStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- FRUIT SELECTOR & EXPANDED HORIZONTAL SCROLLABLE EXAMPLE QUESTIONS BAR -->
                        <Border Grid.Row="2" Background="#0A182C" Padding="12,8" BorderBrush="#152B49" BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Fruit Selection Bar (Limon / Portakal) -->
                                    <RowDefinition Height="Auto"/> <!-- Horizontal Scrollable Questions for Selected Fruit -->
                                </Grid.RowDefinitions>

                                <!-- ROW 0: Meyve Seçimi (Limon / Portakal) - Tamamen Ayrılmış & Ferah Tasarım -->
                                <Grid Grid.Row="0" Margin="0,2,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Sol Taraf: Meyve Seçiniz & Seçim Butonları -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#102544" BorderBrush="#1C3D68" BorderThickness="1.2" CornerRadius="8" Padding="8,4" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🌱" FontSize="11" Margin="0,0,4,0"/>
                                                <TextBlock Text="Meyve Seçiniz:" Foreground="#8FA3BF" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Limon Seç Butonu -->
                                        <Button x:Name="ChatSelectLimonBtn" Click="ChatSelectFruit_Click" Tag="limon"
                                                Background="#2E2408" BorderBrush="#FFD600" BorderThickness="1.5"
                                                Padding="11,4" Margin="0,0,6,0" Cursor="Hand" ToolTip="Limon hastalıkları ve reçetelerini listele">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="lbd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🍋" FontSize="11.5" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="ChatLimonBtnText" Text="Limon" Foreground="#FFD600" FontSize="11" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Portakal Seç Butonu -->
                                        <Button x:Name="ChatSelectPortakalBtn" Click="ChatSelectFruit_Click" Tag="portakal"
                                                Background="#102544" BorderBrush="#1C3D68" BorderThickness="1.2"
                                                Padding="11,4" Cursor="Hand" ToolTip="Portakal hastalıkları ve reçetelerini listele">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="pbd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🍊" FontSize="11.5" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="ChatPortakalBtnText" Text="Portakal" Foreground="#8899AA" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <!-- Sağ Taraf: Aktif Reçete Rozeti (Taşma Korumalı & Sağa Hizalı) -->
                                    <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Background="#0D223C" BorderBrush="#1B3F6C" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="6,0,0,0">
                                        <TextBlock x:Name="ChatActiveFruitSubtitle" Text="🍋 Limon Reçeteleri" 
                                                   Foreground="#FFD600" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </Grid>

                                <!-- ROW 1: Scrollable Chips Bar for Selected Fruit -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Left Scroll Btn -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- Scrollable Chips -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- Right Scroll Btn -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Scroll Button -->
                                    <Button Grid.Column="0" Click="ScrollChipsLeft_Click"
                                            Width="24" Height="30" Background="#132742" BorderThickness="0"
                                            Foreground="#00E676" FontWeight="Bold" FontSize="12" Cursor="Hand" Margin="0,0,4,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <TextBlock Text="◀" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- ScrollViewer with questions -->
                                    <ScrollViewer Grid.Column="1" x:Name="ChipsScrollViewer"
                                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <Grid>
                                            <!-- 1. LİMON ÖZEL HASTALIKLARI VE İLAÇ SORULARI -->
                                            <StackPanel x:Name="LimonChipsPanel" Orientation="Horizontal" Visibility="Visible">
                                                <Button Style="{StaticResource QuickChipStyle}" Content="🍋 Uçkurutan İlaç Markaları &amp; Budama?" Click="Chip_Click" 
                                                        Tag="Limonda uçkurutan (Phoma tracheiphila) hastalığı var. Hangi ticari ilaç markaları, hangi dozda ve nasıl kullanılmalı? Budama ve macun kuralları nedir?"/>
                                                <Button Style="{StaticResource QuickChipStyle}" Content="🍋 Limon Çiçek Güvesi (Prays citri) İlacı?" Click="Chip_Click" 
                                                        Tag="Limon çiçek güvesi için hangi ruhsatlı ilaç markaları, kaç gram dozajla ve ne zaman püskürtülmeli?"/>
                                                <Button Style="{StaticResource QuickChipStyle}" Content="🕷️ Limon Pas Böcüsü (Gümüşi Leke) &amp; Kırmızı Örümcek?" Click="Chip_Click" 
                                                        Tag="Limonda pas böcüsü gümüşi lekesi ve kırmızı örümcek için hangi ilaç markaları, dozajı ve bekleme süresi önerilir?"/>
                                                <Button Style="{StaticResource QuickChipStyle}" Content="🟡 Limonda Demir Klorozu &amp; Şelat Dozu?" Click="Chip_Click" 
                                                        Tag="Limon yapraklarında sararma var. Hangi marka EDDHA şelatlı demir, ağaç başı kaç gram ve topraktan nasıl verilmeli?"/>
                                                <Button Style="{StaticResource QuickChipStyle}" Content="🌳 Limon Gövde Zamklanması &amp; Aliette?" Click="Chip_Click" 
                                                        Tag="Limon ağacı gövdesinde zamk akıntısı ve kabuk çatlağı var. Hangi fungisit markası, dozajı ve yara temizliği nasıl olmalı?"/>
                                                <Button Style="{StaticResource QuickChipStyle}" Content="🍋 Limon Antraknoz &amp; Bakır Takvimi?" Click="Chip_Click" 
                                                        Tag="Limonda yaprak ve sürgün antraknozu için hangi bakır markaları, bordo bulamacı dozu ve uygulama kuralları nedir?"/>
                                                <Button Style="{StaticResource QuickChipStyle}" Content="💔 Limon Kabuk Çatlaması &amp; Kalsiyum?" Click="Chip_Click" 
                                                        Tag="Limonda meyve kabuk çatlamasını önlemek için hangi kalsiyum ve sulama programı uygulanmalı?"/>
                                                <Button Style="{StaticResource QuickChipStyle}" Content="🌾 300 Limon Ağacı Rekoltesi &amp; Cirosu?" Click="Chip_Click" 
                                                        Tag="300 limon ağacım var, ağaç başı 650 meyve var, kaç ton çıkar ve ne kazanırım?"/>
                                                <Button Style="{StaticResource QuickChipStyle}" Content="💧 Limon Damla Sulama &amp; Gübreleme?" Click="Chip_Click" 
                                                        Tag="Limon ağaçları damla sulama ile kaç günde bir sulanmalı ve hangi gübreler verilmeli?"/>
                                            </StackPanel>

                                            <!-- 2. PORTAKAL ÖZEL HASTALIKLARI VE İLAÇ SORULARI -->
                                            <StackPanel x:Name="PortakalChipsPanel" Orientation="Horizontal" Visibility="Collapsed">
                                                <Button Style="{StaticResource QuickChipStyle}" Content="🍊 Akdeniz Meyve Sineği Tuzak &amp; İlaç Markaları?" Click="Chip_Click" 
                                                        Tag="Portakalda Akdeniz meyve sineği için hangi ticari ilaç markaları, zehirli yem kısmi dal ilaçlaması dozu ve tuzaklar nasıl uygulanmalı?"/>
                                                <Button Style="{StaticResource QuickChipStyle}" Content="🐛 Portakalda Unlu Bit &amp; Karaballık (Fumajin)?" Click="Chip_Click" 
                                                        Tag="Portakalda unlu bit ve karaballık mantarı için hangi ilaç markaları, yazlık beyaz yağ dozu ve uygulama şekli nedir?"/>
                                                <Button Style="{StaticResource QuickChipStyle}" Content="🌳 Portakal Gövde Zamklanması (Phytophthora) İlaçları?" Click="Chip_Click" 
                                                        Tag="Portakal ağacında gövde zamklanması ve kök çürüklüğü için Aliette ve Ridomil markaları nasıl ve hangi dozda kullanılır?"/>
                                                <Button Style="{StaticResource QuickChipStyle}" Content="🍊 Kırmızı Kabuklu Bit &amp; Yazlık Yağ Dozu?" Click="Chip_Click" 
                                                        Tag="Portakalda kırmızı kabuklu bit (Aonidiella aurantii) için hangi ilaç markaları ve yazlık yağ nasıl atılmalı?"/>
                                                <Button Style="{StaticResource QuickChipStyle}" Content="🍂 Portakal Meyve Dökümü &amp; Çinko/Magnezyum?" Click="Chip_Click" 
                                                        Tag="Portakalda haziran meyve dökümü neden olur? Çinko ve magnezyum eksikliği için hangi yaprak gübresi markaları verilmeli?"/>
                                                <Button Style="{StaticResource QuickChipStyle}" Content="🍊 Portakal Kabuk Kalınlaşması &amp; Koflaşma?" Click="Chip_Click" 
                                                        Tag="Portakal meyvesinde kabuk kalınlaşması ve koflaşma nasıl önlenir? Potasyum ve fosfor dengesi nasıl kurulmalı?"/>
                                                <Button Style="{StaticResource QuickChipStyle}" Content="🧪 Portakal Gübreleme &amp; Potasyum Takvimi?" Click="Chip_Click" 
                                                        Tag="Portakal bahçesi için yıllık gübreleme takvimi, azot, fosfor ve potasyum oranları nasıl olmalı?"/>
                                                <Button Style="{StaticResource QuickChipStyle}" Content="🌾 500 Portakal Ağacı Verimi &amp; Geliri?" Click="Chip_Click" 
                                                        Tag="500 portakal ağacım var, ağaç başı 400 meyve var, rekolte ve gelir ne olur?"/>
                                            </StackPanel>
                                        </Grid>
                                    </ScrollViewer>

                                    <!-- Right Scroll Button -->
                                    <Button Grid.Column="2" Click="ScrollChipsRight_Click"
                                            Width="24" Height="30" Background="#132742" BorderThickness="0"
                                            Foreground="#00E676" FontWeight="Bold" FontSize="12" Cursor="Hand" Margin="4,0,0,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                    <TextBlock Text="▶" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Chat Input Box + Mic Button -->
                        <Border Grid.Row="3" Background="#0C1B33" BorderBrush="#152B49" BorderThickness="0,1,0,0" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Voice Ask / Mic Button -->
                                <Button Grid.Column="0" x:Name="VoiceAskButton" Click="VoiceAsk_Click"
                                        Width="40" Height="40" Margin="0,0,8,0" Cursor="Hand"
                                        ToolTip="Sesli Soru Sor / Karşılıklı Konuş">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="micBd" Background="#16325C" CornerRadius="20">
                                                <TextBlock Text="🎙️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="micBd" Property="Background" Value="#00E676"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Text Input -->
                                <Border Grid.Column="1" Background="#07101C" BorderBrush="#183359" 
                                        BorderThickness="1.5" CornerRadius="20" Padding="14,8,14,8" Margin="0,0,10,0">
                                    <TextBox x:Name="UserInputBox"
                                             Style="{StaticResource ModernTextBoxStyle}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="False"
                                             VerticalAlignment="Center"
                                             MaxHeight="90"
                                             VerticalScrollBarVisibility="Auto"
                                             KeyDown="UserInputBox_KeyDown"
                                             GotFocus="UserInputBox_GotFocus"
                                             LostFocus="UserInputBox_LostFocus"
                                             Tag="Nova ile konuşun, soru sorun veya ağaç sayısı yazın..."/>
                                </Border>

                                <!-- Send Button -->
                                <Button Grid.Column="2" x:Name="SendButton"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Width="40" Height="40"
                                        Padding="0"
                                        Click="SendButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" CornerRadius="20" Width="40" Height="40">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#00E676" Offset="0"/>
                                                        <GradientStop Color="#00897B" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock Text="➤" Foreground="White" FontSize="16" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Margin="2,0,0,0"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ===== RIGHT PANEL: PHOTO CAPTURE & YOLO ANALYSIS ===== -->
                <Border Grid.Column="1" Background="#081220">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="28,20,28,30">

                            <!-- Section Title & Quick Crop Samples -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

