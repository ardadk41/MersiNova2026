<Window x:Class="MersiNova.GoogleMapsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MersiNova — Canlı Google Maps Bahçe Konum Seçici"
        Height="700" Width="960"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Border Background="#081220" BorderBrush="#1C3D68" BorderThickness="1.5" CornerRadius="20"
            MouseDown="Window_MouseDown" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.75" BlurRadius="35" ShadowDepth="10"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Search & Quick Location Toolbar -->
                <RowDefinition Height="*"/>    <!-- WebView2 Google Maps Area -->
                <RowDefinition Height="Auto"/> <!-- Bottom Confirmation Bar -->
            </Grid.RowDefinitions>

            <!-- 1. Custom Title Bar -->
            <Border Grid.Row="0" Background="#0C1B33" BorderBrush="#142C4E" BorderThickness="0,0,0,1" Padding="20,10">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛰️" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="Canlı Google Maps — Zirai Bahçe &amp; Parsel Konum Belirleme" 
                                   Foreground="#ECEFF4" FontSize="13" FontWeight="Bold"/>
                        <Border Background="#1C3558" CornerRadius="5" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Google Uydu &amp; Hibrit" Foreground="#00E676" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Close Button -->
                    <Button HorizontalAlignment="Right" Click="CloseButton_Click"
                            Width="28" Height="28" Background="#14253D" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="cbd" Background="{TemplateBinding Background}" CornerRadius="14">
                                    <TextBlock Text="✕" Foreground="#B2C7DF" FontSize="12" FontWeight="Bold" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="cbd" Property="Background" Value="#E74C3C"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Search & Preset Toolbar -->
            <Border Grid.Row="1" Background="#09182E" BorderBrush="#16325C" BorderThickness="0,0,0,1" Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/> <!-- Search Bar -->
                        <ColumnDefinition Width="*"/>   <!-- Quick Preset Chips -->
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <Border Grid.Column="0" Background="#0C1B33" BorderBrush="#1E4476" BorderThickness="1.2" CornerRadius="10" Height="36" Padding="10,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="SearchBox"
                                     Text="Mersin Erdemli Limonlu"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#ECEFF4"
                                     FontSize="12"
                                     VerticalAlignment="Center"
                                     KeyDown="SearchBox_KeyDown"/>
                            <Button Grid.Column="2" Click="SearchButton_Click"
                                    Background="#142C4E" BorderBrush="#00E676" BorderThickness="1"
                                    Padding="8,3" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <TextBlock Text="Git" Foreground="#00E676" FontSize="10.5" FontWeight="Bold"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Quick Preset Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Hızlı Git:" Foreground="#5A718C" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0"/>

                        <Button Click="Preset_Click" Tag="36.6025,34.3142,Mersin / Erdemli - Limonlu"
                                Background="#102544" Foreground="#00E676" FontSize="10.5" FontWeight="SemiBold"
                                Padding="8,4" Margin="0,0,5,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="🍋 Erdemli (Limonlu)"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Click="Preset_Click" Tag="36.3778,33.9344,Mersin / Silifke - Göksu Vadisi"
                                Background="#102544" Foreground="#FFD600" FontSize="10.5" FontWeight="SemiBold"
                                Padding="8,4" Margin="0,0,5,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="🍊 Silifke (Göksu)"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Click="Preset_Click" Tag="36.9167,34.8950,Mersin / Tarsus - Narenciye Ovası"
                                Background="#102544" Foreground="#FF9100" FontSize="10.5" FontWeight="SemiBold"
                                Padding="8,4" Margin="0,0,5,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="🍋 Tarsus"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Click="Preset_Click" Tag="36.9850,35.3289,Adana / Yüreğir - Portakal Bahçesi"
                                Background="#102544" Foreground="#FF6D00" FontSize="10.5" FontWeight="SemiBold"
                                Padding="8,4" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="🍊 Yüreğir"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Real Google Maps WebView2 Viewport -->
            <Grid Grid.Row="2" Background="#061220">
                <wv2:WebView2 x:Name="MapWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                <!-- Loading Overlay -->
                <Border x:Name="MapLoadingOverlay" Background="#E6081220" Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🛰️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Canlı Google Maps Yükleniyor..." Foreground="#00E676" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Uydu ve parsel verileri çekiliyor, lütfen bekleyiniz..." Foreground="#7E93AA" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Floating Interaction Hint -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" 
                        Background="#CC081220" BorderBrush="#1C3D68" BorderThickness="1" CornerRadius="8" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👆 " FontSize="12"/>
                        <TextBlock Text="Haritayı basılı tutup sürükleyin • Bahçenize tıklayarak pini yerleştirin • Tekerlek ile yakınlaşın" 
                                   Foreground="#B2C7DF" FontSize="10.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. Bottom Confirmation Bar -->
            <Border Grid.Row="3" Background="#0C1B33" BorderBrush="#16325C" BorderThickness="0,1,0,0" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Selected Location Info -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📍 Seçilen Bahçe Konumu:" Foreground="#88A0B8" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DisplayLocationText" 
                                       Text="Mersin / Erdemli - Limonlu Havzası (36.6025° K, 34.3142° D)" 
                                       Foreground="#00E676" FontSize="12.5" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Border Background="#4A1818" CornerRadius="4" Padding="6,1" Margin="0,0,8,0">
                                <TextBlock Text="⚠️ DOLU &amp; YAĞMUR RADARI MENZİLİNDE" Foreground="#FF8A80" FontSize="9.5" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="DisplayCoordsText" Text="Koordinat: 36.6025° K, 34.3142° D • Uydu Netliği: Yüksek" Foreground="#5A718C" FontSize="10.5"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Cancel Button -->
                        <Button Click="CloseButton_Click" Height="40" Padding="14,0" Margin="0,0,10,0"
                                Background="#14253D" BorderBrush="#1C3D68" BorderThickness="1" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="İptal" Foreground="#B2C7DF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Confirm Button -->
                        <Button Click="ConfirmLocation_Click" Height="40" Padding="18,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="cfmbd" CornerRadius="10">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00E676" Offset="0"/>
                                                <GradientStop Color="#00B0FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock Text="✅" FontSize="14" Margin="0,0,8,0"/>
                                            <TextBlock Text="BU KONUMU ONAYLA &amp; AKTAR" Foreground="#04121E" FontSize="12.5" FontWeight="ExtraBold"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="cfmbd" Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
