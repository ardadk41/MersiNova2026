<Window x:Class="MersiNova.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MersiNova" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Pulse Animation for orbs -->
        <Storyboard x:Key="PulseAnim" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Orb1"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="0.8" Duration="0:0:2"
                             AutoReverse="True"/>
        </Storyboard>
        <Storyboard x:Key="PulseAnim2" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Orb2"
                             Storyboard.TargetProperty="Opacity"
                             From="0.2" To="0.6" Duration="0:0:2.5"
                             AutoReverse="True"/>
        </Storyboard>
        <Storyboard x:Key="PulseAnim3" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Orb3"
                             Storyboard.TargetProperty="Opacity"
                             From="0.15" To="0.5" Duration="0:0:3"
                             AutoReverse="True"/>
        </Storyboard>

        <!-- Rotate for brain icon -->
        <Storyboard x:Key="ThinkingAnim" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ThinkingRing1"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:4"/>
            <DoubleAnimation Storyboard.TargetName="ThinkingRing2"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="360" To="0" Duration="0:0:6"/>
            <DoubleAnimation Storyboard.TargetName="ThinkingRing3"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:8"/>
        </Storyboard>

        <!-- Fade in animation -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetName="RootBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:1.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Button hover style -->
        <Style x:Key="GlassButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A00FF87"/>
            <Setter Property="Foreground" Value="#00FF87"/>
            <Setter Property="BorderBrush" Value="#4400FF87"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect Color="#00FF87" BlurRadius="0" Opacity="0" ShadowDepth="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="ButtonBorder"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#3300FF87" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)"
                                                             To="15" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                                                             To="0.7" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="ButtonBorder"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#1A00FF87" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)"
                                                             To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonBorder"
                                                             Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                                                             To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Camera Button Style -->
        <Style x:Key="CameraButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A64FFDA"/>
            <Setter Property="BorderBrush" Value="#4464FFDA"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CamBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <Border.Effect>
                                <DropShadowEffect Color="#64FFDA" BlurRadius="0" Opacity="0" ShadowDepth="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="CamBorder"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#3364FFDA" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="CamBorder"
                                                             Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)"
                                                             To="20" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="CamBorder"
                                                             Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                                                             To="0.8" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="CamBorder"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#1A64FFDA" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="CamBorder"
                                                             Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)"
                                                             To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="CamBorder"
                                                             Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                                                             To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Send Button -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00FF87"/>
            <Setter Property="Foreground" Value="#0A0E1A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SendBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <Border.Effect>
                                <DropShadowEffect Color="#00FF87" BlurRadius="8" Opacity="0.5" ShadowDepth="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="SendBorder"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#39FF14" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="SendBorder"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#00FF87" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
            <BeginStoryboard Storyboard="{StaticResource PulseAnim}"/>
            <BeginStoryboard Storyboard="{StaticResource PulseAnim2}"/>
            <BeginStoryboard Storyboard="{StaticResource PulseAnim3}"/>
            <BeginStoryboard Storyboard="{StaticResource ThinkingAnim}"/>
        </EventTrigger>
    </Window.Triggers>

    <!-- Root container with rounded corners -->
    <Border x:Name="RootBorder" CornerRadius="20" Opacity="0" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="60" Opacity="0.8" ShadowDepth="0"/>
        </Border.Effect>
        <Grid>
            <!-- Background gradient -->
            <Border CornerRadius="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0A0E1A" Offset="0"/>
                        <GradientStop Color="#0D1B2A" Offset="0.4"/>
                        <GradientStop Color="#0A1628" Offset="0.7"/>
                        <GradientStop Color="#060D18" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Ambient orbs (decorative blurred circles) -->
            <Ellipse x:Name="Orb1" Width="500" Height="500"
                     HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-150,-150,0,0" Opacity="0.3">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3000FF87" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse x:Name="Orb2" Width="400" Height="400"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-100,-100" Opacity="0.2">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2064FFDA" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse x:Name="Orb3" Width="300" Height="300"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="200,-100,0,0" Opacity="0.15">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1500D4AA" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Grid overlay pattern -->
            <Canvas ClipToBounds="True" Opacity="0.04">
                <Canvas.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,0" EndPoint="0,40"/>
                                        <LineGeometry StartPoint="0,0" EndPoint="40,0"/>
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                                <GeometryDrawing.Pen>
                                    <Pen Brush="White" Thickness="0.5"/>
                                </GeometryDrawing.Pen>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Canvas.Background>
            </Canvas>

            <!-- Window drag handle & close button -->
            <Grid Panel.ZIndex="100" VerticalAlignment="Top">
                <Border Background="Transparent" Height="50" MouseDown="Border_MouseDown"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Width="14" Height="14" Margin="6,0"
                            Background="#FFC300" BorderThickness="0"
                            Cursor="Hand" Click="MinimizeBtn_Click"
                            ToolTip="Küçült">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Ellipse Fill="{TemplateBinding Background}" Width="14" Height="14"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Width="14" Height="14" Margin="6,0"
                            Background="#FF5F57" BorderThickness="0"
                            Cursor="Hand" Click="CloseBtn_Click"
                            ToolTip="Kapat">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Ellipse Fill="{TemplateBinding Background}" Width="14" Height="14"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Layout: Left Panel + Right Panel -->
            <Grid Margin="0,50,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== LEFT PANEL: Branding + AI Orb ===== -->
                <Grid Grid.Column="0" Margin="50,20,30,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo & Title -->
                    <StackPanel Grid.Row="0" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Leaf icon as Path -->
                            <Viewbox Width="36" Height="36" Margin="0,0,10,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M17 8C8 10 5.9 16.17 3.82 19.5C2 22 2 22 2 22C2 22 8.5 22 13 18.5C17.5 15 18 10 17 8ZM17 8C17 8 22 9 22 15C22 20 18 22 18 22" 
                                          Stroke="#00FF87" StrokeThickness="1.5" Fill="Transparent"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Ellipse Width="4" Height="4" Canvas.Left="10" Canvas.Top="14" Fill="#00FF87" Opacity="0.7"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="MersiNova" FontSize="32" FontWeight="Bold"
                                       FontFamily="Segoe UI" VerticalAlignment="Center">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FF87" Offset="0"/>
                                        <GradientStop Color="#64FFDA" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#00FF87" BlurRadius="12" Opacity="0.4" ShadowDepth="0"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="Yapay Zekâ Destekli Akıllı Tarım Sistemi"
                                   Foreground="#8892B0" FontSize="12" FontFamily="Segoe UI"
                                   Margin="46,4,0,0"/>
                    </StackPanel>

                    <!-- AI Brain Orb (center of left panel) -->
                    <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Outer glow -->
                        <Ellipse Width="280" Height="280" Opacity="0.12">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#00FF87" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Rotating ring 3 (outermost) -->
                        <Ellipse x:Name="ThinkingRing3" Width="220" Height="220" Stroke="#1500FF87" StrokeThickness="1"
                                 StrokeDashArray="4 6" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Rotating ring 2 -->
                        <Ellipse x:Name="ThinkingRing2" Width="175" Height="175" Stroke="#2200D4AA" StrokeThickness="1.5"
                                 StrokeDashArray="8 4" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Rotating ring 1 (inner) -->
                        <Ellipse x:Name="ThinkingRing1" Width="130" Height="130" Stroke="#4400FF87" StrokeThickness="2"
                                 StrokeDashArray="3 3" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Core orb -->
                        <Ellipse Width="90" Height="90">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#3300FF87" Offset="0"/>
                                    <GradientStop Color="#1100D4AA" Offset="0.6"/>
                                    <GradientStop Color="#0A112240" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#00FF87" BlurRadius="25" Opacity="0.6" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Brain icon inside orb -->
                        <Viewbox Width="42" Height="42">
                            <Canvas Width="24" Height="24">
                                <!-- Neural network dots -->
                                <Ellipse Width="3" Height="3" Canvas.Left="5" Canvas.Top="8" Fill="#00FF87"/>
                                <Ellipse Width="3" Height="3" Canvas.Left="11" Canvas.Top="5" Fill="#64FFDA"/>
                                <Ellipse Width="3" Height="3" Canvas.Left="16" Canvas.Top="8" Fill="#00FF87"/>
                                <Ellipse Width="3" Height="3" Canvas.Left="5" Canvas.Top="14" Fill="#64FFDA"/>
                                <Ellipse Width="3" Height="3" Canvas.Left="11" Canvas.Top="12" Fill="#00FF87"/>
                                <Ellipse Width="3" Height="3" Canvas.Left="16" Canvas.Top="14" Fill="#64FFDA"/>
                                <Ellipse Width="3" Height="3" Canvas.Left="8" Canvas.Top="19" Fill="#00FF87"/>
                                <Ellipse Width="3" Height="3" Canvas.Left="14" Canvas.Top="19" Fill="#64FFDA"/>
                                <!-- Connections -->
                                <Line X1="6.5" Y1="9.5" X2="12.5" Y2="6.5" Stroke="#3300FF87" StrokeThickness="0.7"/>
                                <Line X1="12.5" Y1="6.5" X2="17.5" Y2="9.5" Stroke="#3300FF87" StrokeThickness="0.7"/>
                                <Line X1="6.5" Y1="9.5" X2="6.5" Y2="15.5" Stroke="#3300FF87" StrokeThickness="0.7"/>
                                <Line X1="6.5" Y1="15.5" X2="12.5" Y2="13.5" Stroke="#3300FF87" StrokeThickness="0.7"/>
                                <Line X1="12.5" Y1="13.5" X2="17.5" Y2="15.5" Stroke="#3300FF87" StrokeThickness="0.7"/>
                                <Line X1="17.5" Y1="9.5" X2="17.5" Y2="15.5" Stroke="#3300FF87" StrokeThickness="0.7"/>
                                <Line X1="12.5" Y1="6.5" X2="12.5" Y2="13.5" Stroke="#3300FF87" StrokeThickness="0.7"/>
                                <Line X1="9.5" Y1="20.5" X2="12.5" Y2="13.5" Stroke="#3300FF87" StrokeThickness="0.7"/>
                                <Line X1="15.5" Y1="20.5" X2="12.5" Y2="13.5" Stroke="#3300FF87" StrokeThickness="0.7"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>

                    <!-- Status chips at bottom of left panel -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Border Background="#0D1B2A" BorderBrush="#1E3A5F" BorderThickness="1" CornerRadius="20" Padding="12,6" Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#00FF87" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#00FF87" BlurRadius="6" Opacity="0.9" ShadowDepth="0"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="YOLO AI Aktif" Foreground="#8892B0" FontSize="10" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#0D1B2A" BorderBrush="#1E3A5F" BorderThickness="1" CornerRadius="20" Padding="12,6" Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#64FFDA" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#64FFDA" BlurRadius="6" Opacity="0.9" ShadowDepth="0"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="Kamera Hazır" Foreground="#8892B0" FontSize="10" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Divider -->
                <Border Grid.Column="0" Width="1" HorizontalAlignment="Right" Margin="0,40,0,40" VerticalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#2200FF87" Offset="0.3"/>
                            <GradientStop Color="#4400FF87" Offset="0.5"/>
                            <GradientStop Color="#2200FF87" Offset="0.7"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- ===== RIGHT PANEL: Chat / AI Interaction ===== -->
                <Grid Grid.Column="1" Margin="30,10,50,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,10,0,16">
                        <TextBlock Text="Merhaba! Ben MersiNova AI 🌿"
                                   Foreground="#E8F4FD" FontSize="20" FontWeight="SemiBold"
                                   FontFamily="Segoe UI"/>
                        <TextBlock Text="Bahçenizdeki meyveleri analiz etmek, hasat planı oluşturmak veya herhangi bir soru sormak için yazın."
                                   Foreground="#8892B0" FontSize="11" FontFamily="Segoe UI"
                                   TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="18"/>
                    </StackPanel>

                    <!-- Chat Messages Area -->
                    <Border Grid.Row="1" CornerRadius="16" Margin="0,0,0,12">
                        <Border.Background>
                            <SolidColorBrush Color="#080C18"/>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1500FF87" Offset="0"/>
                                <GradientStop Color="#1064FFDA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.BorderThickness>1</Border.BorderThickness>

                        <ScrollViewer x:Name="ChatScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="16,12">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar">
                                    <Setter Property="Width" Value="4"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ScrollViewer.Resources>
                            <StackPanel x:Name="ChatPanel" Orientation="Vertical">

                                <!-- Welcome AI Message -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Top">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#2200FF87" Offset="0"/>
                                                <GradientStop Color="#1100D4AA" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#00FF87" BlurRadius="8" Opacity="0.5" ShadowDepth="0"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Viewbox Grid.Column="0" Width="16" Height="16" Margin="8,8,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <Canvas Width="24" Height="24">
                                            <Ellipse Width="4" Height="4" Canvas.Left="4" Canvas.Top="8" Fill="#00FF87"/>
                                            <Ellipse Width="4" Height="4" Canvas.Left="10" Canvas.Top="5" Fill="#64FFDA"/>
                                            <Ellipse Width="4" Height="4" Canvas.Left="16" Canvas.Top="8" Fill="#00FF87"/>
                                            <Line X1="6" Y1="10" X2="12" Y2="7" Stroke="#4400FF87" StrokeThickness="1"/>
                                            <Line X1="12" Y1="7" X2="18" Y2="10" Stroke="#4400FF87" StrokeThickness="1"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Border Grid.Column="1" CornerRadius="4,16,16,16" Padding="14,10">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#0D1B2A" Offset="0"/>
                                                <GradientStop Color="#112240" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="#1E3A5F"/>
                                        </Border.BorderBrush>
                                        <Border.BorderThickness>1</Border.BorderThickness>
                                        <StackPanel>
                                            <TextBlock Text="MersiNova AI sisteme hoş geldiniz! 🌱"
                                                       Foreground="#E8F4FD" FontSize="12" FontFamily="Segoe UI"
                                                       FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock TextWrapping="Wrap" FontSize="11" FontFamily="Segoe UI"
                                                       Foreground="#8892B0" LineHeight="18">
                                                <Run Text="Bahçenizin fotoğrafını çekebilir veya görsel yükleyebilirsiniz. Yapay zekâ motorum meyveleri tespit ederek olgunluk analizi, tahmini hasat tarihi ve verimlilik raporu oluşturacak."/>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Border Background="#0A00FF87" BorderBrush="#2200FF87" BorderThickness="1" CornerRadius="20" Padding="8,3" Margin="0,0,6,0">
                                                    <TextBlock Text="🍊 Meyve Tespiti" Foreground="#00FF87" FontSize="9" FontFamily="Segoe UI"/>
                                                </Border>
                                                <Border Background="#0A64FFDA" BorderBrush="#2264FFDA" BorderThickness="1" CornerRadius="20" Padding="8,3" Margin="0,0,6,0">
                                                    <TextBlock Text="📊 Olgunluk Analizi" Foreground="#64FFDA" FontSize="9" FontFamily="Segoe UI"/>
                                                </Border>
                                                <Border Background="#0A00D4AA" BorderBrush="#2200D4AA" BorderThickness="1" CornerRadius="20" Padding="8,3">
                                                    <TextBlock Text="🗓️ Hasat Tahmini" Foreground="#00D4AA" FontSize="9" FontFamily="Segoe UI"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- AI Thinking indicator (animated dots) -->
                                <Grid x:Name="ThinkingIndicator" Margin="0,0,0,12" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Top">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#2200FF87" Offset="0"/>
                                                <GradientStop Color="#1100D4AA" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Border Grid.Column="1" CornerRadius="4,16,16,16" Padding="16,12"
                                            Background="#0D1B2A" BorderBrush="#1E3A5F" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="ThinkingDot1" Text="●" Foreground="#00FF87" FontSize="14" Margin="2,0"/>
                                            <TextBlock x:Name="ThinkingDot2" Text="●" Foreground="#00FF87" FontSize="14" Margin="2,0" Opacity="0.5"/>
                                            <TextBlock x:Name="ThinkingDot3" Text="●" Foreground="#00FF87" FontSize="14" Margin="2,0" Opacity="0.2"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Quick Action Chips -->
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource GlassButtonStyle}" Padding="10,6" Margin="0,0,8,0"
                                    FontSize="11" Click="QuickAction_Click" Tag="Bahçemi analiz et">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🍎 " FontSize="11"/>
                                    <TextBlock Text="Bahçemi analiz et" FontSize="11" Foreground="#00FF87"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GlassButtonStyle}" Padding="10,6" Margin="0,0,8,0"
                                    FontSize="11" Click="QuickAction_Click" Tag="Hasat planı oluştur">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📅 " FontSize="11"/>
                                    <TextBlock Text="Hasat planı" FontSize="11" Foreground="#00FF87"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GlassButtonStyle}" Padding="10,6" Margin="0,0,8,0"
                                    FontSize="11" Click="QuickAction_Click" Tag="Verimlilik raporu göster">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊 " FontSize="11"/>
                                    <TextBlock Text="Verimlilik raporu" FontSize="11" Foreground="#00FF87"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GlassButtonStyle}" Padding="10,6" Margin="0,0,8,0"
                                    FontSize="11" Click="QuickAction_Click" Tag="Meyve sayımı yap">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔢 " FontSize="11"/>
                                    <TextBlock Text="Meyve sayımı" FontSize="11" Foreground="#00FF87"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Input Area ===== -->
                    <Border Grid.Row="3" CornerRadius="16" Padding="10">
                        <Border.Background>
                            <SolidColorBrush Color="#0D1B2A"/>
                        </Border.Background>
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2200FF87" Offset="0"/>
                                <GradientStop Color="#1564FFDA" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.BorderThickness>1.5</Border.BorderThickness>
                        <Border.Effect>
                            <DropShadowEffect Color="#00FF87" BlurRadius="12" Opacity="0.08" ShadowDepth="0"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Camera Capture Button -->
                            <Button Grid.Column="0"
                                    x:Name="CameraBtn"
                                    Style="{StaticResource CameraButtonStyle}"
                                    Width="48" Height="48"
                                    Margin="2,0,8,0"
                                    Click="CameraBtn_Click"
                                    ToolTip="Fotoğraf çek veya görsel yükle">
                                <Viewbox Width="22" Height="22">
                                    <Canvas Width="24" Height="24">
                                        <!-- Camera body -->
                                        <Rectangle Width="18" Height="12" Canvas.Left="3" Canvas.Top="7"
                                                   RadiusX="2" RadiusY="2" Stroke="#64FFDA" StrokeThickness="1.5" Fill="Transparent"/>
                                        <!-- Lens -->
                                        <Ellipse Width="6" Height="6" Canvas.Left="9" Canvas.Top="10"
                                                 Stroke="#64FFDA" StrokeThickness="1.5" Fill="Transparent"/>
                                        <!-- Viewfinder bump -->
                                        <Path Data="M8 7 L9.5 4.5 L14.5 4.5 L16 7" Stroke="#64FFDA" StrokeThickness="1.2"
                                              StrokeLineJoin="Round" Fill="Transparent"/>
                                        <!-- Flash dot -->
                                        <Ellipse Width="2" Height="2" Canvas.Left="17" Canvas.Top="9.5" Fill="#64FFDA"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>

                            <!-- Text input -->
                            <Border Grid.Column="1" CornerRadius="10" Background="Transparent">
                                <TextBox x:Name="MessageInput"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#E8F4FD"
                                         FontFamily="Segoe UI"
                                         FontSize="13"
                                         CaretBrush="#00FF87"
                                         SelectionBrush="#3300FF87"
                                         VerticalAlignment="Center"
                                         TextWrapping="Wrap"
                                         MaxLines="4"
                                         AcceptsReturn="False"
                                         KeyDown="MessageInput_KeyDown"
                                         TextChanged="MessageInput_TextChanged"
                                         Padding="4,8">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Grid>
                                                            <TextBlock x:Name="PlaceholderText"
                                                                       Text="Meyve bahçeniz hakkında soru sorun veya görsel yükleyin..."
                                                                       Foreground="#3D4F6B"
                                                                       FontFamily="Segoe UI"
                                                                       FontSize="13"
                                                                       VerticalAlignment="Center"
                                                                       Padding="4,8"
                                                                       IsHitTestVisible="False"
                                                                       Visibility="Visible"/>
                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                          VerticalScrollBarVisibility="Hidden"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                                                            </Trigger>
                                                            <Trigger Property="Text" Value="{x:Null}">
                                                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding Text.Length, RelativeSource={RelativeSource Self}}" Value="0">
                                                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Border>

                            <!-- Attach / Image upload button -->
                            <Button Grid.Column="2"
                                    Style="{StaticResource CameraButtonStyle}"
                                    Width="38" Height="38"
                                    Margin="6,0,4,0"
                                    Click="AttachBtn_Click"
                                    ToolTip="Dosya yükle">
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M21.44 11.05L12.25 20.24C11.12 21.37 9.6 22 8 22C6.4 22 4.88 21.37 3.75 20.24C2.62 19.11 2 17.6 2 16C2 14.4 2.62 12.88 3.75 11.76L12.94 2.57C13.7 1.81 14.73 1.38 15.8 1.38C16.87 1.38 17.9 1.81 18.66 2.57C19.42 3.33 19.85 4.36 19.85 5.43C19.85 6.5 19.42 7.53 18.66 8.29L9.46 17.49C9.08 17.87 8.56 18.08 8.02 18.08C7.48 18.08 6.96 17.87 6.58 17.49C6.2 17.11 5.99 16.59 5.99 16.05C5.99 15.51 6.2 14.99 6.58 14.61L15.07 6.12"
                                              Stroke="#64FFDA" StrokeThickness="1.5" Fill="Transparent"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>

                            <!-- Send Button -->
                            <Button Grid.Column="3"
                                    x:Name="SendBtn"
                                    Style="{StaticResource SendButtonStyle}"
                                    Width="48" Height="48"
                                    Margin="4,0,0,0"
                                    Click="SendBtn_Click">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M22 2L11 13M22 2L15 22L11 13L2 9L22 2Z"
                                              Stroke="#0A0E1A" StrokeThickness="2" Fill="Transparent"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
